# Where waitlist signups are forwarded. Google Apps Script exec URL, Formspree
# endpoint, or any HTTPS endpoint that accepts a JSON POST.
# Left unset, the form still validates but returns a clear "not configured"
# error rather than pretending to succeed.
WAITLIST_WEBHOOK_URL=

# Plausible site domain, e.g. measured.in. Unset means no analytics script
# is rendered at all.
PLAUSIBLE_DOMAIN=

# Canonical origin, used for canonical URLs, OG, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://measured.in

# Footer link. Unset hides the link rather than rendering a dead one.
INSTAGRAM_URL=
