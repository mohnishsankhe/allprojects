{"id": "tea:nyayabindutika:1.1", "source": "src:nyayabindutika", "location": {"ref": "1.1"}, "paraphrase": "A means of valid cognition is a non-deceptive cognition, i.e. one that makes one attain (prāpaka) the object it shows; the treatise explains right cognition because people who act with forethought seek it before acting.", "tags": {"level": "conventional", "standpoint": "analytic", "naya": null, "path": ["knowledge"], "stage": "all"}, "types": ["dispute"], "terms": ["trm:avisamvadin", "trm:prapaka"], "concepts": ["cpt:pramana-definition-buddhist"], "teachers": ["tch:dharmottara"], "commentary_on": "tea:nyayabindu:1.1", "notes": "Paraphrase of Dharmottara's opening comments, from memory.", "coverage": ["B4", "D"], "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U41-yogacara-pramana"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U41-yogacara-pramana"], "phases": ["skeleton"]}}
