{"id": "tea:namaskara-mantra:1-5", "source": "src:namaskara-mantra", "location": {"ref": "1-5", "section": null}, "original": {"text": "ṇamo arihaṃtāṇaṃ / ṇamo siddhāṇaṃ / ṇamo āyariyāṇaṃ / ṇamo uvajjhāyāṇaṃ / ṇamo loe savva-sāhūṇaṃ", "script": "IAST (Prakrit)", "edition": "standard liturgical text", "licence": "public-domain text"}, "paraphrase": "Homage to the Arhats; homage to the Siddhas; homage to the Ācāryas; homage to the Upādhyāyas; homage to all the Sādhus in the world.", "tags": {"level": "conventional", "standpoint": "devotional", "naya": null, "path": ["sound", "devotion"], "stage": "all"}, "types": ["sound-language", "practice"], "terms": ["trm:namaskara-mantra", "trm:paramesthin"], "concepts": ["cpt:pancaparamesthin", "cpt:jain-mantra-theory"], "practices": ["prc:namaskara-japa"], "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U35-jain-philosophy"], "disagreements": []}, "correction_log": [], "notes": "The homage is to qualities and states, not to named persons; the Arhats precede the Siddhas because they teach the path.", "coverage": ["B2"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U35-jain-philosophy"], "phases": ["skeleton"]}}
{"id": "tea:namaskara-mantra:6-9", "source": "src:namaskara-mantra", "location": {"ref": "6-9", "section": null}, "original": {"text": "eso paṃca-ṇamokkāro / savva-pāva-ppaṇāsaṇo / maṃgalāṇaṃ ca savvesiṃ / paḍhamaṃ havaï maṃgalaṃ", "script": "IAST (Prakrit)", "edition": "standard Śvetāmbara liturgical text", "licence": "public-domain text"}, "paraphrase": "This fivefold homage destroys all evil and is the first of all auspicious things.", "tags": {"level": "conventional", "standpoint": "devotional", "naya": null, "path": ["sound", "devotion"], "stage": "all"}, "types": ["sound-language"], "terms": ["trm:culika", "trm:namaskara-mantra"], "concepts": ["cpt:jain-mantra-theory"], "practices": ["prc:namaskara-japa"], "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U35-jain-philosophy"], "disagreements": []}, "correction_log": [], "notes": "The cūlikā; recited by Śvetāmbaras and by many Digambaras.", "coverage": ["B2"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U35-jain-philosophy"], "phases": ["skeleton"]}}
