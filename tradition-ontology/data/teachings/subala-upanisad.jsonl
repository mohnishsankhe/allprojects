{"id": "tea:subala-upanisad:1-2", "source": "src:subala-upanisad", "location": {"ref": "1-2"}, "paraphrase": "In the beginning there was neither being nor non-being; from the unborn arose darkness, elements, the egg and the Person with a thousand heads; from him all creatures.", "tags": {"level": "conventional", "standpoint": "cosmic", "naya": null, "path": ["knowledge"], "stage": "all"}, "types": ["world-fate"], "extraction": {"method": "skeleton", "extractors": [], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "coverage": ["A2"], "provenance": {"units": ["skeleton:U04-minor-upanisads"], "phases": ["skeleton"]}}
{"id": "tea:subala-upanisad:13", "source": "src:subala-upanisad", "location": {"ref": "13"}, "paraphrase": "The knower lives like a child, unattached, like one mute or mad.", "tags": {"level": "ultimate", "standpoint": "absolute", "naya": null, "path": ["knowledge"], "stage": "advanced"}, "types": ["ethics", "karma-liberation"], "extraction": {"method": "skeleton", "extractors": [], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "coverage": ["A2"], "provenance": {"units": ["skeleton:U04-minor-upanisads"], "phases": ["skeleton"]}}
{"id": "tea:subala-upanisad:16", "source": "src:subala-upanisad", "location": {"ref": "16"}, "paraphrase": "This teaching is not to be given to one who is not calm, not a son or disciple.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["general"], "stage": "all"}, "types": ["teacher-transmission"], "concepts": ["cpt:secrecy-and-eligibility"], "extraction": {"method": "skeleton", "extractors": [], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "coverage": ["A2"], "provenance": {"units": ["skeleton:U04-minor-upanisads"], "phases": ["skeleton"]}}
{"id": "tea:subala-upanisad:7", "source": "src:subala-upanisad", "location": {"ref": "7"}, "paraphrase": "He whose body is the earth, who moves within the earth and whom the earth does not know… whose body is the mind, the self… he is the inner self of all beings, free of evil, the divine, the one Nārāyaṇa.", "tags": {"level": "ultimate", "standpoint": "absolute", "naya": null, "path": ["knowledge"], "stage": "all"}, "types": ["ultimate"], "concepts": ["cpt:three-selves"], "extraction": {"method": "skeleton", "extractors": [], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "coverage": ["A2"], "provenance": {"units": ["skeleton:U04-minor-upanisads"], "phases": ["skeleton"]}}
