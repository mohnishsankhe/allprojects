{"id": "tea:tattvartha-rajavarttika:1.1", "source": "src:tattvartha-rajavarttika", "location": {"ref": "1.1", "chapter": "1", "verse": "1", "section": null}, "original": {"text": "hataṃ jñānaṃ kriyāhīnaṃ hatā cājñānināṃ kriyā / dhāvan kilāndhako dagdhaḥ paśyann api ca paṅgulaḥ", "script": "IAST", "edition": "recalled by the unit author (wording believed standard; to be checked against an edition)", "licence": "public-domain text"}, "paraphrase": "Knowledge without action is lost and action of the ignorant is lost: the blind man burns while running, the lame man while seeing — so view, knowledge and conduct must go together.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["knowledge", "action"], "stage": "all"}, "types": ["karma-liberation"], "concepts": ["cpt:three-jewels"], "teachers": ["tch:akalanka"], "disputes": ["dsp:jnana-karma-samuccaya"], "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U35-jain-philosophy"], "disagreements": []}, "correction_log": [], "notes": "Widely quoted verse; its citation at Rājavārttika 1.1 is recalled, not checked.", "coverage": ["B2"], "verification": {"level": "skeleton", "confidence": "low", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U35-jain-philosophy"], "phases": ["skeleton"]}}
