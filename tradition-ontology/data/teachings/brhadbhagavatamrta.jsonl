{"id": "tea:brhadbhagavatamrta:1", "source": "src:brhadbhagavatamrta", "location": {"ref": "1"}, "paraphrase": "Nārada searches for the greatest recipient of Kṛṣṇa's grace — from a king to Indra, Brahmā, Śiva, Prahlāda, Hanumān, the Pāṇḍavas, the Yādavas and Uddhava — and is led to the gopīs of Vraja, whose love surpasses all.", "tags": {"level": "conventional", "standpoint": "devotional", "naya": null, "path": ["devotion"], "stage": "all"}, "types": ["karma-liberation"], "coverage": ["A6"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U16-bhedabheda"], "disagreements": []}, "teachers": ["tch:sanatana-gosvami"], "paths": [], "notes": "Part-level reference.", "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U16-bhedabheda"], "phases": ["skeleton"]}}
{"id": "tea:brhadbhagavatamrta:2", "source": "src:brhadbhagavatamrta", "location": {"ref": "2"}, "paraphrase": "The cowherd Gopakumāra, chanting his guru's mantra, rises through the worlds, liberation in Brahman and Vaikuṇṭha, to Goloka, where Kṛṣṇa's intimate play is attained through spontaneous love.", "tags": {"level": "conventional", "standpoint": "devotional", "naya": null, "path": ["devotion", "sound"], "stage": "all"}, "types": ["karma-liberation", "world-fate"], "coverage": ["A6"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U16-bhedabheda"], "disagreements": []}, "teachers": ["tch:sanatana-gosvami"], "concepts": ["cpt:spiritual-abode"], "notes": "Part-level reference.", "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U16-bhedabheda"], "phases": ["skeleton"]}}
