{"id": "tea:parting-from-four-attachments:context", "source": "src:parting-from-four-attachments", "location": {"ref": "context", "section": "the tradition's account of the revelation"}, "paraphrase": "At twelve, during a six-month retreat on Mañjuśrī under Bari Lotsawa, Sachen Kunga Nyingpo saw Mañjuśrī, who spoke the four lines of Parting from the Four Attachments; Sachen understood that the whole of the path of the perfections is contained in them.", "tags": {"level": "conventional", "standpoint": "divine", "naya": null, "path": ["devotion"], "stage": "all"}, "types": ["teacher-transmission", "powers-experiences"], "teachers": ["tch:sachen-kunga-nyingpo", "tch:bari-lotsawa", "tch:manjusri"], "notes": "Hagiographical narrative, not a line of the text.", "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U47-sakya-kadam-gelug"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U47-sakya-kadam-gelug"], "phases": ["skeleton"]}}
