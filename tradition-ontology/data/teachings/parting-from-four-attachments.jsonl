{"id": "tea:parting-from-four-attachments:1", "source": "src:parting-from-four-attachments", "location": {"ref": "1", "verse": "1"}, "paraphrase": "If you are attached to this life, you are not a dharma practitioner.", "tags": {"level": "conventional", "standpoint": "ethical-social", "naya": null, "path": ["general"], "stage": "all"}, "types": ["practice", "karma-liberation"], "teachers": ["tch:sachen-kunga-nyingpo", "tch:manjusri"], "concepts": ["cpt:four-attachments", "cpt:three-scopes"], "obstacles": ["obs:attachment-to-this-life", "obs:eight-worldly-concerns"], "terms": ["trm:zhenpa-zhidral"], "paths": ["pth:parting-from-four-attachments"], "notes": "Line wording recalled; the Tibetan of line 2 is given variously as 'khor ba' or 'khams gsum'. Sakya teachers correlate the lines with the three scopes and the view.", "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U47-sakya-kadam-gelug"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U47-sakya-kadam-gelug"], "phases": ["skeleton"]}}
{"id": "tea:parting-from-four-attachments:2", "source": "src:parting-from-four-attachments", "location": {"ref": "2", "verse": "2"}, "paraphrase": "If you are attached to saṃsāra (the three realms), you do not have renunciation.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["general"], "stage": "all"}, "types": ["practice", "karma-liberation"], "teachers": ["tch:sachen-kunga-nyingpo", "tch:manjusri"], "concepts": ["cpt:four-attachments", "cpt:renunciation"], "obstacles": ["obs:attachment-to-samsara"], "terms": ["trm:zhenpa-zhidral"], "paths": ["pth:parting-from-four-attachments"], "notes": "Line wording recalled; the Tibetan of line 2 is given variously as 'khor ba' or 'khams gsum'. Sakya teachers correlate the lines with the three scopes and the view.", "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U47-sakya-kadam-gelug"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U47-sakya-kadam-gelug"], "phases": ["skeleton"]}}
{"id": "tea:parting-from-four-attachments:3", "source": "src:parting-from-four-attachments", "location": {"ref": "3", "verse": "3"}, "paraphrase": "If you are attached to your own purpose, you do not have the mind of awakening.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["general"], "stage": "all"}, "types": ["practice", "karma-liberation"], "teachers": ["tch:sachen-kunga-nyingpo", "tch:manjusri"], "concepts": ["cpt:four-attachments", "cpt:bodhicitta"], "obstacles": ["obs:self-cherishing"], "terms": ["trm:zhenpa-zhidral"], "paths": ["pth:parting-from-four-attachments"], "notes": "Line wording recalled; the Tibetan of line 2 is given variously as 'khor ba' or 'khams gsum'. Sakya teachers correlate the lines with the three scopes and the view.", "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U47-sakya-kadam-gelug"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U47-sakya-kadam-gelug"], "phases": ["skeleton"]}}
