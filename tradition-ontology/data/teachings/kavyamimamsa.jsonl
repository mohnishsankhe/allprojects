{"id": "tea:kavyamimamsa:3", "source": "src:kavyamimamsa", "location": {"ref": "3", "chapter": "3"}, "paraphrase": "The Poetry-Man (kāvyapuruṣa) was born as Sarasvatī's son: word and meaning his body, Sanskrit his mouth, rasa his self, metres his hair, figures his ornaments; he is wedded to the Poetics-Bride (sāhityavidyā).", "tags": {"level": "conventional", "standpoint": "divine", "naya": null, "path": ["general"], "stage": "all"}, "types": ["sound-language", "teacher-transmission"], "teachers": ["tch:rajasekhara"], "notes": "Chapter-level reference.", "reported_by_opponent": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U31-sound-arts"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U31-sound-arts"], "phases": ["skeleton"]}}
