{"id": "tea:vitaragastotra:ch.19", "source": "src:vitaragastotra", "location": {"ref": "ch.19", "section": null}, "paraphrase": "Obeying your command is higher than worshipping you; your command, kept or broken, leads to liberation or to worldly existence. For all time your command concerns what to abandon and what to adopt: inflow is always to be abandoned, stopping to be adopted.", "tags": {"level": "conventional", "standpoint": "devotional", "naya": null, "path": ["devotion", "action"], "stage": "all"}, "types": ["practice", "karma-liberation"], "terms": ["trm:asrava", "trm:samvara"], "concepts": ["cpt:asrava", "cpt:samvara"], "teachers": ["tch:hemacandra"], "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U35-jain-philosophy"], "disagreements": []}, "correction_log": [], "notes": "Chapter 19; verse numbers not checked.", "coverage": ["B2"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U35-jain-philosophy"], "phases": ["skeleton"]}}
