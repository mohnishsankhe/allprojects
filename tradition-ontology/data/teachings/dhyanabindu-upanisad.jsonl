{"id": "tea:dhyanabindu-upanisad:1", "source": "src:dhyanabindu-upanisad", "location": {"ref": "1"}, "paraphrase": "Even if sin were piled high as a mountain many yojanas wide, it is destroyed by the yoga of meditation, and by nothing else ever.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["meditation"], "stage": "intermediate"}, "types": ["practice", "karma-liberation"], "extraction": {"method": "skeleton", "extractors": [], "disagreements": []}, "verification": {"level": "sourced", "confidence": "high", "unverified": false, "checks": [{"phase": "C", "date": "2026-09-29", "method": "text-locate", "queries": ["e-text dhyanabindu-upanisad 1"], "evidence": ["catalog:raw_etexts:108_Upanishads", "text:sources_raw/raw_etexts/vedaH/misc/upaniShat/mixedPF/108_Upanishads.md"], "result": "confirmed", "note": "E-text 1 located in the e-text; the passage matches the paraphrase.", "by": "sourcing:U04-minor-upanisads"}]}, "coverage": ["A2"], "provenance": {"units": ["skeleton:U04-minor-upanisads"], "phases": ["skeleton"]}}
