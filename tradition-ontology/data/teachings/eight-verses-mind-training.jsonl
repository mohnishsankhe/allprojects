{"id": "tea:eight-verses-mind-training:1", "source": "src:eight-verses-mind-training", "location": {"ref": "1", "verse": "1"}, "paraphrase": "Determined to achieve the highest good for all beings, who surpass even a wish-fulfilling jewel, may I always hold them dear.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["meditation", "action"], "stage": "all"}, "types": ["practice", "ethics"], "teachers": ["tch:langri-tangpa"], "practices": ["prc:lojong"], "concepts": ["cpt:kindness-of-beings"], "terms": ["trm:lojong"], "obstacles": [], "notes": "Recalled; the eighth verse's two lines are sometimes counted as relating to ultimate bodhicitta.", "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U47-sakya-kadam-gelug"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U47-sakya-kadam-gelug"], "phases": ["skeleton"]}}
{"id": "tea:eight-verses-mind-training:2", "source": "src:eight-verses-mind-training", "location": {"ref": "2", "verse": "2"}, "paraphrase": "Whenever I am with others, may I see myself as the lowest of all and from the depth of my heart hold others supreme.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["meditation", "action"], "stage": "all"}, "types": ["practice", "ethics"], "teachers": ["tch:langri-tangpa"], "practices": ["prc:lojong"], "concepts": [], "terms": ["trm:lojong"], "obstacles": ["obs:self-cherishing"], "notes": "Recalled; the eighth verse's two lines are sometimes counted as relating to ultimate bodhicitta.", "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U47-sakya-kadam-gelug"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U47-sakya-kadam-gelug"], "phases": ["skeleton"]}}
{"id": "tea:eight-verses-mind-training:3", "source": "src:eight-verses-mind-training", "location": {"ref": "3", "verse": "3"}, "paraphrase": "In all my actions may I examine my mind, and as soon as an affliction arises — since it harms myself and others — may I firmly confront and avert it.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["meditation", "action"], "stage": "all"}, "types": ["practice", "ethics"], "teachers": ["tch:langri-tangpa"], "practices": ["prc:lojong"], "concepts": ["cpt:lojong-precepts"], "terms": ["trm:lojong"], "obstacles": [], "notes": "Recalled; the eighth verse's two lines are sometimes counted as relating to ultimate bodhicitta.", "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U47-sakya-kadam-gelug"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U47-sakya-kadam-gelug"], "phases": ["skeleton"]}}
{"id": "tea:eight-verses-mind-training:4", "source": "src:eight-verses-mind-training", "location": {"ref": "4", "verse": "4"}, "paraphrase": "When I see beings of bad nature, oppressed by strong wrongdoing and suffering, may I cherish them as if I had found a rare treasure.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["meditation", "action"], "stage": "all"}, "types": ["practice", "ethics"], "teachers": ["tch:langri-tangpa"], "practices": ["prc:lojong"], "concepts": [], "terms": ["trm:lojong"], "obstacles": [], "notes": "Recalled; the eighth verse's two lines are sometimes counted as relating to ultimate bodhicitta.", "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U47-sakya-kadam-gelug"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U47-sakya-kadam-gelug"], "phases": ["skeleton"]}}
{"id": "tea:eight-verses-mind-training:5", "source": "src:eight-verses-mind-training", "location": {"ref": "5", "verse": "5"}, "paraphrase": "When others out of envy treat me wrongly with abuse, slander and the like, may I take defeat upon myself and offer the victory to others.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["meditation", "action"], "stage": "all"}, "types": ["practice", "ethics"], "teachers": ["tch:langri-tangpa"], "practices": ["prc:lojong"], "concepts": ["cpt:taking-adversity-as-path"], "terms": ["trm:lojong"], "obstacles": ["obs:self-cherishing"], "notes": "Recalled; the eighth verse's two lines are sometimes counted as relating to ultimate bodhicitta.", "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U47-sakya-kadam-gelug"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U47-sakya-kadam-gelug"], "phases": ["skeleton"]}}
{"id": "tea:eight-verses-mind-training:6", "source": "src:eight-verses-mind-training", "location": {"ref": "6", "verse": "6"}, "paraphrase": "When someone I have helped with great hope harms me very badly, may I see that person as my supreme spiritual teacher.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["meditation", "action"], "stage": "all"}, "types": ["practice", "ethics"], "teachers": ["tch:langri-tangpa"], "practices": ["prc:lojong"], "concepts": ["cpt:taking-adversity-as-path"], "terms": ["trm:lojong"], "obstacles": [], "notes": "Recalled; the eighth verse's two lines are sometimes counted as relating to ultimate bodhicitta.", "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U47-sakya-kadam-gelug"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U47-sakya-kadam-gelug"], "phases": ["skeleton"]}}
{"id": "tea:eight-verses-mind-training:7", "source": "src:eight-verses-mind-training", "location": {"ref": "7", "verse": "7"}, "paraphrase": "In short, may I offer, directly and indirectly, all help and happiness to all my mothers, and secretly take upon myself all their harm and suffering.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["meditation", "action"], "stage": "all"}, "types": ["practice", "ethics"], "teachers": ["tch:langri-tangpa"], "practices": ["prc:lojong", "prc:tonglen"], "concepts": ["cpt:exchanging-self-and-other"], "terms": ["trm:lojong", "trm:tonglen"], "obstacles": [], "notes": "Recalled; the eighth verse's two lines are sometimes counted as relating to ultimate bodhicitta.", "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U47-sakya-kadam-gelug"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U47-sakya-kadam-gelug"], "phases": ["skeleton"]}}
{"id": "tea:eight-verses-mind-training:8", "source": "src:eight-verses-mind-training", "location": {"ref": "8", "verse": "8"}, "paraphrase": "May all this remain undefiled by the stains of the eight worldly concerns, and, knowing all phenomena as illusion, may I be freed from the bondage of clinging.", "tags": {"level": "bridging", "standpoint": "seeker", "naya": null, "path": ["meditation", "knowledge"], "stage": "all"}, "types": ["practice", "ultimate"], "teachers": ["tch:langri-tangpa"], "practices": ["prc:lojong"], "concepts": ["cpt:illusion-similes"], "terms": ["trm:lojong"], "obstacles": ["obs:eight-worldly-concerns"], "notes": "Recalled; the eighth verse's two lines are sometimes counted as relating to ultimate bodhicitta.", "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U47-sakya-kadam-gelug"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U47-sakya-kadam-gelug"], "phases": ["skeleton"]}}
