{"id": "tea:naradiya-siksa:1.7.1-4", "source": "src:naradiya-siksa", "location": {"ref": "1.7.1-4", "chapter": "1", "verse": "7", "section": null}, "paraphrase": "The places of the Sāman notes: kruṣṭa at the head, prathama on the forehead, dvitīya between the brows, tṛtīya at the ears, caturtha in the throat, mandra in the chest, atisvārya in the heart; on the hand the kruṣṭa is shown at the top of the thumb, prathama on the thumb, gāndhāra (dvitīya) on the forefinger, then the others on the following fingers.", "tags": {"level": "conventional", "standpoint": "analytic", "naya": null, "path": ["sound", "body-breath"], "stage": "all"}, "types": ["sound-language", "body-layers"], "teachers": ["tch:narada"], "terms": ["trm:svara"], "concepts": ["cpt:sama-svaras-and-musical-notes"], "practices": ["prc:sama-gana"], "notes": "Checked (1.7.1–4).", "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked", "checked_by": null, "date": null, "note": ""}, "extraction": {"method": "skeleton", "extractors": ["U01-vedic-samhitas"], "disagreements": []}, "correction_log": [], "verification": {"level": "sourced", "confidence": "high", "unverified": false, "checks": [{"phase": "C", "date": "2026-09-28", "method": "text-locate", "queries": ["local Nāradīya Śikṣā 1.7"], "evidence": ["text:sources_raw/raw_etexts/shixA/sAma-vedaH/naradiya_shiksha.md"], "result": "confirmed", "note": "Text-located (1.7.1–4): kruṣṭa at the head, prathama forehead, dvitīya between the brows, tṛtīya ears, caturtha throat, mandra chest, atisvārya heart; on the hand kruṣṭa at the top of the thumb … (1.7.3 reads prādeśinī for gāndhāra).", "by": "sourcing:U01-vedic-samhitas"}]}, "provenance": {"units": ["skeleton:U01-vedic-samhitas"], "phases": ["skeleton"]}}
