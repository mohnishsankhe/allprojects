{"id": "tea:vyadha-gita:3.199.19-29", "source": "src:vyadha-gita", "location": {"ref": "3.199.19-29", "chapter": "3.199", "verse": "19-29", "section": "Vyādha Gītā"}, "paraphrase": "The meat-seller: people think agriculture good, yet great violence lies in it — ploughing, men kill many creatures living in the earth; even ascetics devoted to non-violence do some violence, though by effort it becomes less.", "tags": {"level": "conventional", "standpoint": "ethical-social", "naya": null, "path": ["action"], "stage": "all"}, "types": ["ethics", "dispute"], "terms": ["trm:ahimsa"], "concepts": ["cpt:non-violence", "cpt:subtlety-of-dharma"], "teachers": ["tch:dharmavyadha"], "disputes": ["dsp:violence-and-svadharma"], "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U05-gita-epic"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "notes": "Verse ref checked against the local digitized text (Critical Edition).", "provenance": {"units": ["skeleton:U05-gita-epic"], "phases": ["skeleton"]}}
