{"id": "tea:parabrahma-upanisad:1-6", "source": "src:parabrahma-upanisad", "location": {"ref": "1-6"}, "paraphrase": "Śaunaka asks Pippalāda; the one seeking liberation bears the inner topknot and thread, the ritualist householder the outer; the haṃsa is the topknot, the praṇava the thread, nāda the union.", "tags": {"level": "bridging", "standpoint": "seeker", "naya": null, "path": ["knowledge"], "stage": "advanced"}, "types": ["ethics", "ultimate"], "concepts": ["cpt:inner-sikha-yajnopavita", "cpt:hamsa"], "extraction": {"method": "skeleton", "extractors": [], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "coverage": ["A2"], "provenance": {"units": ["skeleton:U04-minor-upanisads"], "phases": ["skeleton"]}}
