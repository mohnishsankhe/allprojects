{"id": "tea:atharvasikha-upanisad:1", "source": "src:atharvasikha-upanisad", "location": {"ref": "1"}, "paraphrase": "Pippalāda, Aṅgiras and Sanatkumāra ask Atharvan what is the first meditation; Atharvan: Oṃ, the imperishable, with its measures corresponding to worlds, Vedas, fires and deities (Brahmā, Viṣṇu, Rudra, and the half-measure).", "tags": {"level": "conventional", "standpoint": "devotional", "naya": null, "path": ["devotion", "sound"], "stage": "all"}, "types": ["sound-language"], "concepts": ["cpt:omkara-matras"], "teachers": ["tch:atharvan", "tch:pippalada", "tch:angiras", "tch:sanatkumara"], "extraction": {"method": "skeleton", "extractors": [], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "coverage": ["A2"], "provenance": {"units": ["skeleton:U04-minor-upanisads"], "phases": ["skeleton"]}}
