{"id": "tea:pancapadika:1", "source": "src:pancapadika", "location": {"ref": "1"}, "paraphrase": "Ignorance is an insentient power (avidyā-śakti), the material cause of superimposition; the word 'mithyā' in the adhyāsa-bhāṣya means 'indescribable' (anirvacanīya).", "tags": {"level": "bridging", "standpoint": "analytic", "naya": null, "path": ["knowledge"], "stage": "all"}, "types": ["consciousness-mind"], "terms": ["trm:mithya", "trm:anirvacaniya", "trm:bhavarupa-avidya"], "concepts": ["cpt:bhavarupa-avidya", "cpt:mithyatva"], "disputes": ["dsp:bhavarupa-avidya"], "notes": "Section-level (commentary on the adhyāsa-bhāṣya).", "teachers": ["tch:padmapada"], "reported_by_opponent": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U13-advaita"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "low", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U13-advaita"], "phases": ["skeleton"]}}
