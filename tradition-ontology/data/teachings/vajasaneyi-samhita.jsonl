{"id": "tea:vajasaneyi-samhita:31.18", "source": "src:vajasaneyi-samhita", "location": {"ref": "31.18", "chapter": "31", "verse": "18", "section": null}, "paraphrase": "I know this great Person, sun-coloured, beyond darkness; only by knowing him does one go beyond death; there is no other path for going.", "tags": {"level": "ultimate", "standpoint": "seeker", "naya": null, "path": ["knowledge"], "stage": "advanced"}, "types": ["karma-liberation", "ultimate", "death-dying"], "original": {"text": "vedāham etaṃ puruṣaṃ mahāntam ādityavarṇaṃ tamasaḥ parastāt | tam eva viditvāti mṛtyum eti nānyaḥ panthā vidyate 'yanāya", "script": "IAST", "edition": "Vājasaneyi Saṃhitā (Mādhyandina), standard text (IAST, accents omitted); wording checked against sources_raw/DharmicData", "licence": "public domain (ancient text)"}, "terms": ["trm:purusa", "trm:mrtyu"], "concepts": ["cpt:purusa-cosmic-person", "cpt:amrtatva-vedic-immortality"], "cross_refs": ["tea:svetasvatara-upanisad:3.8"], "notes": "One of the six 'Uttaranārāyaṇa' verses (31.17–22); also Śvetāśvatara 3.8 (reference only).", "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked", "checked_by": null, "date": null, "note": ""}, "extraction": {"method": "skeleton", "extractors": ["U01-vedic-samhitas"], "disagreements": []}, "correction_log": [], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U01-vedic-samhitas"], "phases": ["skeleton"]}}
{"id": "tea:vajasaneyi-samhita:31.19", "source": "src:vajasaneyi-samhita", "location": {"ref": "31.19", "chapter": "31", "verse": "19", "section": null}, "paraphrase": "Prajāpati moves within the womb; unborn, he is born in many ways; the wise see his source; in him all the worlds stand.", "tags": {"level": "ultimate", "standpoint": "cosmic", "naya": null, "path": ["knowledge"], "stage": "advanced"}, "types": ["ultimate"], "terms": ["trm:prajapati"], "concepts": ["cpt:hiranyagarbha-golden-germ", "cpt:the-one-tad-ekam"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked", "checked_by": null, "date": null, "note": ""}, "extraction": {"method": "skeleton", "extractors": ["U01-vedic-samhitas"], "disagreements": []}, "correction_log": [], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U01-vedic-samhitas"], "phases": ["skeleton"]}}
{"id": "tea:vajasaneyi-samhita:32.1", "source": "src:vajasaneyi-samhita", "location": {"ref": "32.1", "chapter": "32", "verse": "1", "section": null}, "paraphrase": "That indeed is Agni, that the Sun, that Wind, that the Moon; that is the bright, that is brahman, those the waters, he Prajāpati.", "tags": {"level": "ultimate", "standpoint": "absolute", "naya": null, "path": ["knowledge"], "stage": "all"}, "types": ["ultimate"], "terms": ["trm:brahman", "trm:prajapati"], "concepts": ["cpt:gods-as-names-of-the-one", "cpt:brahman-early-sense"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked", "checked_by": null, "date": null, "note": ""}, "extraction": {"method": "skeleton", "extractors": ["U01-vedic-samhitas"], "disagreements": []}, "correction_log": [], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U01-vedic-samhitas"], "phases": ["skeleton"]}}
{"id": "tea:vajasaneyi-samhita:32.3", "source": "src:vajasaneyi-samhita", "location": {"ref": "32.3", "chapter": "32", "verse": "3", "section": null}, "paraphrase": "There is no likeness (pratimā) of him whose name is great glory.", "tags": {"level": "ultimate", "standpoint": "apophatic", "naya": null, "path": ["knowledge"], "stage": "all"}, "types": ["ultimate"], "original": {"text": "na tasya pratimā asti yasya nāma mahad yaśaḥ", "script": "IAST", "edition": "Vājasaneyi Saṃhitā (Mādhyandina), standard text (IAST, accents omitted); wording checked against sources_raw/DharmicData", "licence": "public domain (ancient text)"}, "concepts": ["cpt:the-one-tad-ekam"], "notes": "Followed by pratīkas of 'Hiraṇyagarbha…', 'may he not harm me…' (checked). Also Śvetāśvatara 4.19 (reference only).", "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked", "checked_by": null, "date": null, "note": ""}, "extraction": {"method": "skeleton", "extractors": ["U01-vedic-samhitas"], "disagreements": []}, "correction_log": [], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U01-vedic-samhitas"], "phases": ["skeleton"]}}
{"id": "tea:vajasaneyi-samhita:32.8", "source": "src:vajasaneyi-samhita", "location": {"ref": "32.8", "chapter": "32", "verse": "8", "section": null}, "paraphrase": "Vena saw that highest, hidden in secret (guhā), in which all becomes one nest; into it all this enters and from it comes forth; he is woven warp and woof through creatures, all-pervading.", "tags": {"level": "ultimate", "standpoint": "experiential", "naya": null, "path": ["knowledge"], "stage": "advanced"}, "types": ["ultimate", "powers-experiences"], "terms": ["trm:hrd"], "teachers": ["tch:vena-bhargava"], "concepts": ["cpt:the-one-tad-ekam", "cpt:heart-as-seat-of-vision"], "cross_refs": ["tea:atharvaveda-saunaka:2.1.1"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked", "checked_by": null, "date": null, "note": ""}, "extraction": {"method": "skeleton", "extractors": ["U01-vedic-samhitas"], "disagreements": []}, "correction_log": [], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U01-vedic-samhitas"], "phases": ["skeleton"]}}
{"id": "tea:vajasaneyi-samhita:34.1", "source": "src:vajasaneyi-samhita", "location": {"ref": "34.1", "chapter": "34", "verse": "1", "section": null}, "paraphrase": "That divine (mind) which goes far away from one who is awake and likewise returns to one asleep, far-going, the one light of lights — may that mind of mine be of auspicious resolve (śivasaṅkalpa).", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["meditation", "knowledge"], "stage": "all"}, "types": ["consciousness-mind"], "terms": ["trm:manas", "trm:hrd"], "concepts": ["cpt:manas-vedic", "cpt:vedic-states-waking-sleep"], "practices": [], "original": {"text": "yaj jāgrato dūram udaiti daivaṃ tad u suptasya tathaivaiti | dūraṃgamaṃ jyotiṣāṃ jyotir ekaṃ tan me manaḥ śivasaṅkalpam astu", "script": "IAST", "edition": "Vājasaneyi Saṃhitā (Mādhyandina), standard text (IAST, accents omitted); wording checked against sources_raw/DharmicData", "licence": "public domain (ancient text)"}, "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked", "checked_by": null, "date": null, "note": ""}, "extraction": {"method": "skeleton", "extractors": ["U01-vedic-samhitas"], "disagreements": []}, "correction_log": [], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U01-vedic-samhitas"], "phases": ["skeleton"]}}
