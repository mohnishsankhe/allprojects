{"id": "tea:vajasaneyi-samhita:34.3", "source": "src:vajasaneyi-samhita", "location": {"ref": "34.3", "chapter": "34", "verse": "3", "section": null}, "paraphrase": "That which is knowing (prajñāna), thought (cetas) and steadfastness (dhṛti), the immortal light within creatures, without which no act whatever is done — may that mind of mine be of auspicious resolve.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["meditation", "knowledge"], "stage": "all"}, "types": ["consciousness-mind"], "terms": ["trm:manas", "trm:hrd"], "concepts": ["cpt:manas-vedic"], "practices": [], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked", "checked_by": null, "date": null, "note": ""}, "extraction": {"method": "skeleton", "extractors": ["U01-vedic-samhitas"], "disagreements": []}, "correction_log": [], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U01-vedic-samhitas"], "phases": ["skeleton"]}}
{"id": "tea:vajasaneyi-samhita:34.4", "source": "src:vajasaneyi-samhita", "location": {"ref": "34.4", "chapter": "34", "verse": "4", "section": null}, "paraphrase": "That immortal by which all this — past, present and future — is held, by which the sacrifice of seven hotṛs is spread — may that mind of mine be of auspicious resolve.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["meditation", "knowledge"], "stage": "all"}, "types": ["consciousness-mind"], "terms": ["trm:manas", "trm:hrd"], "concepts": ["cpt:manas-vedic"], "practices": [], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked", "checked_by": null, "date": null, "note": ""}, "extraction": {"method": "skeleton", "extractors": ["U01-vedic-samhitas"], "disagreements": []}, "correction_log": [], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U01-vedic-samhitas"], "phases": ["skeleton"]}}
{"id": "tea:vajasaneyi-samhita:34.5", "source": "src:vajasaneyi-samhita", "location": {"ref": "34.5", "chapter": "34", "verse": "5", "section": null}, "paraphrase": "That in which the verses, the chants and the formulas are fixed like spokes in the nave of a chariot, in which all the thought (citta) of creatures is woven — may that mind of mine be of auspicious resolve.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["meditation", "knowledge"], "stage": "all"}, "types": ["consciousness-mind"], "terms": ["trm:manas", "trm:hrd"], "concepts": ["cpt:manas-vedic"], "practices": [], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked", "checked_by": null, "date": null, "note": ""}, "extraction": {"method": "skeleton", "extractors": ["U01-vedic-samhitas"], "disagreements": []}, "correction_log": [], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U01-vedic-samhitas"], "phases": ["skeleton"]}}
{"id": "tea:vajasaneyi-samhita:34.6", "source": "src:vajasaneyi-samhita", "location": {"ref": "34.6", "chapter": "34", "verse": "6", "section": null}, "paraphrase": "That which leads men as a good charioteer guides horses with the reins, heart-seated, ageless, swiftest — may that mind of mine be of auspicious resolve.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["meditation", "knowledge"], "stage": "all"}, "types": ["consciousness-mind"], "terms": ["trm:manas", "trm:hrd"], "concepts": ["cpt:manas-vedic"], "practices": [], "notes": "The charioteer image may be compared with the Kaṭha Upaniṣad's chariot (1.3.3–9) — comparison is interpretive.", "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked", "checked_by": null, "date": null, "note": ""}, "extraction": {"method": "skeleton", "extractors": ["U01-vedic-samhitas"], "disagreements": []}, "correction_log": [], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U01-vedic-samhitas"], "phases": ["skeleton"]}}
{"id": "tea:vajasaneyi-samhita:36.1", "source": "src:vajasaneyi-samhita", "location": {"ref": "36.1", "chapter": "36", "verse": "1", "section": null}, "paraphrase": "I take refuge in the ṛc as speech, in the yajus as mind, in the sāman as breath; I take refuge in eye and ear; speech, vigour, strength and in-breath and out-breath be in me.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["sound", "ritual"], "stage": "all"}, "types": ["body-layers", "sound-language"], "terms": ["trm:rc", "trm:yajus", "trm:saman", "trm:vac", "trm:manas", "trm:prana"], "concepts": ["cpt:four-vedas-and-trayi", "cpt:vedic-breaths"], "notes": "Checked (opening).", "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked", "checked_by": null, "date": null, "note": ""}, "extraction": {"method": "skeleton", "extractors": ["U01-vedic-samhitas"], "disagreements": []}, "correction_log": [], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U01-vedic-samhitas"], "phases": ["skeleton"]}}
{"id": "tea:vajasaneyi-samhita:36.17", "source": "src:vajasaneyi-samhita", "location": {"ref": "36.17", "chapter": "36", "verse": "17", "section": null}, "paraphrase": "Peace (śānti) be heaven, peace the atmosphere, peace the earth, peace the waters, peace the plants, peace the trees, peace the All-gods, peace brahman, peace everything; peace, only peace — may that peace be mine.", "tags": {"level": "conventional", "standpoint": "devotional", "naya": null, "path": ["sound"], "stage": "all"}, "types": ["practice"], "terms": ["trm:santi", "trm:brahman"], "practices": ["prc:santi-patha"], "notes": "Checked.", "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked", "checked_by": null, "date": null, "note": ""}, "extraction": {"method": "skeleton", "extractors": ["U01-vedic-samhitas"], "disagreements": []}, "correction_log": [], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U01-vedic-samhitas"], "phases": ["skeleton"]}}
{"id": "tea:vajasaneyi-samhita:36.18", "source": "src:vajasaneyi-samhita", "location": {"ref": "36.18", "chapter": "36", "verse": "18", "section": null}, "paraphrase": "May all beings look on me with the eye of a friend (mitra); may I look on all beings with the eye of a friend; may we look on one another with the eye of a friend.", "tags": {"level": "conventional", "standpoint": "ethical-social", "naya": null, "path": ["general"], "stage": "all"}, "types": ["ethics"], "original": {"text": "mitrasya mā cakṣuṣā sarvāṇi bhūtāni samīkṣantām | mitrasyāhaṃ cakṣuṣā sarvāṇi bhūtāni samīkṣe | mitrasya cakṣuṣā samīkṣāmahe", "script": "IAST", "edition": "Vājasaneyi Saṃhitā (Mādhyandina), standard text (IAST, accents omitted); wording checked against sources_raw/DharmicData", "licence": "public domain (ancient text)"}, "terms": ["trm:mitra"], "concepts": ["cpt:sammanasya-concord"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked", "checked_by": null, "date": null, "note": ""}, "extraction": {"method": "skeleton", "extractors": ["U01-vedic-samhitas"], "disagreements": []}, "correction_log": [], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U01-vedic-samhitas"], "phases": ["skeleton"]}}
{"id": "tea:vajasaneyi-samhita:36.24", "source": "src:vajasaneyi-samhita", "location": {"ref": "36.24", "chapter": "36", "verse": "24", "section": null}, "paraphrase": "That bright eye set by the gods rises in front: may we see a hundred autumns, live a hundred autumns, hear a hundred autumns, speak a hundred autumns, be undiminished a hundred autumns, and more than a hundred autumns.", "tags": {"level": "conventional", "standpoint": "devotional", "naya": null, "path": ["general"], "stage": "all"}, "types": ["death-dying", "ethics"], "terms": ["trm:surya"], "concepts": ["cpt:full-life-hundred-autumns"], "cross_refs": ["tea:rgveda:7.66.16"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked", "checked_by": null, "date": null, "note": ""}, "extraction": {"method": "skeleton", "extractors": ["U01-vedic-samhitas"], "disagreements": []}, "correction_log": [], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U01-vedic-samhitas"], "phases": ["skeleton"]}}
