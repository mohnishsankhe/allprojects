{"id": "tea:tattvapradipika-citsukha:1", "source": "src:tattvapradipika-citsukha", "location": {"ref": "1"}, "original": {"text": "avedyatve sati aparokṣavyavahārayogyatvam", "script": "IAST", "edition": "vulgate wording recalled from memory (verify against an edition)", "licence": "public domain (pre-modern text)"}, "paraphrase": "Self-luminosity (svaprakāśatva) is being fit to be referred to as immediate while not being an object of cognition; consciousness alone has this character.", "tags": {"level": "ultimate", "standpoint": "analytic", "naya": null, "path": ["knowledge"], "stage": "all"}, "types": ["consciousness-mind"], "terms": ["trm:svaprakasa"], "concepts": ["cpt:svaprakasa"], "notes": "Chapter 1; definition wording moderate-high confidence.", "teachers": ["tch:citsukha"], "reported_by_opponent": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U13-advaita"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U13-advaita"], "phases": ["skeleton"]}}
