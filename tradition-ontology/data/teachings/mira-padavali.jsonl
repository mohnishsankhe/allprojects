{"id": "tea:mira-padavali:mere-to-giridhara", "source": "src:mira-padavali", "location": {"ref": "pada 'mere to giradhara gopāla'"}, "paraphrase": "Mine is Giridhar Gopāl, no one else — he who wears the peacock crown is my husband; I have given up family honour; sitting with sādhus I have lost the world's shame.", "tags": {"level": "conventional", "standpoint": "devotional", "naya": null, "path": ["devotion"], "stage": "all"}, "types": ["ethics", "ultimate"], "original": {"text": "मेरे तो गिरधर गोपाल दूसरो न कोई । जाके सिर मोर मुकुट मेरो पति सोई ॥", "script": "Devanāgarī", "edition": "recalled from memory; to be checked against a printed edition", "licence": "public domain (pre-1900 text)"}, "concepts": ["cpt:krsna-as-husband"], "obstacles": ["obs:loka-lajja"], "practices": ["prc:satsanga"], "teachers": ["tch:mirabai"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U26-regional-bhakti"], "disagreements": []}, "coverage": ["A9"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U26-regional-bhakti"], "phases": ["skeleton"]}}
{"id": "tea:mira-padavali:mhane-cakar-rakho", "source": "src:mira-padavali", "location": {"ref": "pada 'mhāṃne cākara rākho jī'"}, "paraphrase": "Keep me as your servant, Giridhārī: as your servant I will plant a garden, see you every morning, and sing your praises in the lanes of Vṛndāvana.", "tags": {"level": "conventional", "standpoint": "devotional", "naya": null, "path": ["devotion"], "stage": "all"}, "types": ["practice"], "concepts": ["cpt:dasya-bhava"], "teachers": ["tch:mirabai"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U26-regional-bhakti"], "disagreements": []}, "coverage": ["A9"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U26-regional-bhakti"], "phases": ["skeleton"]}}
{"id": "tea:mira-padavali:pag-ghunghru", "source": "src:mira-padavali", "location": {"ref": "pada 'paga ghuṃgharū bāṃdha mīrā nācī re'"}, "paraphrase": "Tying bells to her feet Mīrā danced; people said she was mad, her mother-in-law that she had ruined the family; the Rāṇā sent a cup of poison, and Mīrā drank it laughing.", "tags": {"level": "conventional", "standpoint": "devotional", "naya": null, "path": ["devotion"], "stage": "all"}, "types": ["ethics", "powers-experiences"], "obstacles": ["obs:loka-lajja"], "concepts": ["cpt:krsna-as-husband"], "teachers": ["tch:mirabai"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U26-regional-bhakti"], "disagreements": []}, "coverage": ["A9"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U26-regional-bhakti"], "phases": ["skeleton"]}}
{"id": "tea:mira-padavali:payo-ji-maine", "source": "src:mira-padavali", "location": {"ref": "pada 'pāyo jī maiṃne rāma ratana dhana pāyo'"}, "paraphrase": "I have found the jewel-wealth of the name; the true guru gave me this priceless thing; spending does not lessen it and thieves cannot steal it; it grows every day.", "tags": {"level": "conventional", "standpoint": "devotional", "naya": null, "path": ["sound", "devotion"], "stage": "all"}, "types": ["practice"], "concepts": ["cpt:divine-name", "cpt:guru"], "teachers": ["tch:mirabai"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U26-regional-bhakti"], "disagreements": []}, "coverage": ["A9"], "notes": "Attributed; not in the earliest manuscripts.", "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U26-regional-bhakti"], "phases": ["skeleton"]}}
{"id": "tea:mira-padavali:prema-divani", "source": "src:mira-padavali", "location": {"ref": "pada 'he rī maiṃ to prema divānī'"}, "paraphrase": "I am mad with love; no one knows my pain; only the wounded know the wound; my bed is on the gallows — how can I sleep? Mīrā's pain will go only when the dark one becomes the physician.", "tags": {"level": "conventional", "standpoint": "experiential", "naya": null, "path": ["devotion"], "stage": "all"}, "types": ["powers-experiences"], "original": {"text": "हे री मैं तो प्रेम दिवानी मेरो दरद न जाणै कोय ।", "script": "Devanāgarī", "edition": "recalled from memory; to be checked against a printed edition", "licence": "public domain (pre-1900 text)"}, "concepts": ["cpt:viraha-bhakti"], "terms": ["trm:viraha"], "teachers": ["tch:mirabai"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U26-regional-bhakti"], "disagreements": []}, "coverage": ["A9"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U26-regional-bhakti"], "phases": ["skeleton"]}}
