{"id": "tea:ujjvalanilamani:sthayibhava-prakarana", "source": "src:ujjvalanilamani", "location": {"ref": "sthayibhava-prakarana"}, "paraphrase": "Love (prema) intensifies through stages — affection (sneha), love-pique (māna), intimacy (praṇaya), passion (rāga), ever-new passion (anurāga) and great emotion (mahābhāva) — the last found only in the gopīs of Vraja and, in its highest forms, in Rādhā alone.", "tags": {"level": "conventional", "standpoint": "experiential", "naya": null, "path": ["devotion"], "stage": "realized"}, "types": ["consciousness-mind", "powers-experiences"], "coverage": ["A6"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U16-bhedabheda"], "disagreements": []}, "teachers": ["tch:rupa-gosvami"], "paths": ["pth:ujjvalanilamani-prema-ladder"], "concepts": ["cpt:stages-of-prema"], "terms": ["trm:sneha", "trm:mana", "trm:pranaya", "trm:raga", "trm:anuraga", "trm:mahabhava"], "notes": "Chapter-level reference (the chapter on the permanent emotion).", "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U16-bhedabheda"], "phases": ["skeleton"]}}
