{"id": "tea:sanatsujatiya:5.41.5", "source": "src:sanatsujatiya", "location": {"ref": "5.41.5", "chapter": "5.41", "verse": "5", "section": "Udyogaparvan (introduction)"}, "paraphrase": "Vidura: I am born of a śūdra womb and do not venture to speak further; but I know the eternal understanding of the Kumāra (Sanatsujāta).", "tags": {"level": "conventional", "standpoint": "ethical-social", "naya": null, "path": ["knowledge"], "stage": "all"}, "types": ["teacher-transmission", "dispute"], "speaker": "Vidura", "addressee": "Dhṛtarāṣṭra", "concepts": ["cpt:gita-transmission"], "teachers": ["tch:vidura", "tch:sanatsujata"], "disputes": ["dsp:varna-by-birth-or-conduct-epic"], "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U05-gita-epic"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "notes": "Verse ref checked against the local digitized text (Critical Edition).", "provenance": {"units": ["skeleton:U05-gita-epic"], "phases": ["skeleton"]}}
{"id": "tea:sanatsujatiya:5.42-43", "source": "src:sanatsujatiya", "location": {"ref": "5.42-43", "chapter": "5.42-43", "section": "Sanatsujātīya"}, "paraphrase": "Sanatsujāta teaches that the Vedas do not save the deceitful; that the brāhmaṇa is one who knows Brahman, not one who merely recites; that silence (mauna) is the self; and he names the virtues — truth, self-restraint, freedom from envy, modesty, forbearance, sacrifice, giving and the like — and the faults such as anger, desire and greed.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["knowledge"], "stage": "all"}, "types": ["ethics", "sound-language"], "terms": ["trm:mauna", "trm:dama", "trm:satya"], "teachers": ["tch:sanatsujata"], "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U05-gita-epic"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U05-gita-epic"], "phases": ["skeleton"]}}
{"id": "tea:sanatsujatiya:5.42.4", "source": "src:sanatsujatiya", "location": {"ref": "5.42.4", "chapter": "5.42", "verse": "4", "section": "Sanatsujātīya"}, "paraphrase": "Both are true, kṣatriya: that death is abolished by action, and that there is no death; I declare heedlessness to be death and constant heedfulness to be immortality.", "tags": {"level": "ultimate", "standpoint": "seeker", "naya": null, "path": ["knowledge", "meditation"], "stage": "all"}, "types": ["death-dying", "karma-liberation"], "speaker": "Sanatsujāta", "addressee": "Dhṛtarāṣṭra", "terms": ["trm:pramada", "trm:apramada"], "practices": ["prc:apramada"], "obstacles": ["obs:pramada"], "teachers": ["tch:sanatsujata"], "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U05-gita-epic"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "notes": "Verse ref checked against the local digitized text (Critical Edition).", "provenance": {"units": ["skeleton:U05-gita-epic"], "phases": ["skeleton"]}}
{"id": "tea:sanatsujatiya:5.43.14", "source": "src:sanatsujatiya", "location": {"ref": "5.43.14", "chapter": "5.43", "verse": "14", "section": "Sanatsujātīya"}, "paraphrase": "Self-restraint, renunciation and heedfulness — in these immortality is placed; the wise brāhmaṇas say they have truth as their face.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["general"], "stage": "all"}, "types": ["ethics", "karma-liberation"], "terms": ["trm:dama", "trm:tyaga", "trm:apramada"], "cross_refs": ["tea:mahabharata:11.7.13-20"], "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U05-gita-epic"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "notes": "Verse ref checked against the local digitized text (Critical Edition).", "provenance": {"units": ["skeleton:U05-gita-epic"], "phases": ["skeleton"]}}
{"id": "tea:sanatsujatiya:5.44", "source": "src:sanatsujatiya", "location": {"ref": "5.44", "chapter": "5.44", "section": "Sanatsujātīya"}, "paraphrase": "Sanatsujāta teaches the quarters of brahmacarya: one quarter is gained from the teacher, one by one's own intelligence, one from fellow students, and one in the course of time.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["knowledge"], "stage": "beginner"}, "types": ["teacher-transmission"], "terms": ["trm:brahmacarya"], "concepts": ["cpt:gita-transmission"], "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U05-gita-epic"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U05-gita-epic"], "phases": ["skeleton"]}}
{"id": "tea:sanatsujatiya:5.45.1", "source": "src:sanatsujatiya", "location": {"ref": "5.45.1", "chapter": "5.45", "verse": "1", "section": "Sanatsujātīya"}, "paraphrase": "That pure, great light, shining, great glory, which the gods worship and by which the sun shines — the yogins see that eternal Lord.", "tags": {"level": "ultimate", "standpoint": "experiential", "naya": null, "path": ["meditation", "knowledge"], "stage": "advanced"}, "types": ["ultimate"], "terms": ["trm:brahman"], "teachers": ["tch:sanatsujata"], "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U05-gita-epic"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "notes": "The refrain 'yoginas taṃ prapaśyanti bhagavantaṃ sanātanam' closes each verse of 5.45 (checked).", "provenance": {"units": ["skeleton:U05-gita-epic"], "phases": ["skeleton"]}}
