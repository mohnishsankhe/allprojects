{"id": "tea:nyayamanjari:1.opening", "source": "src:nyayamanjari", "location": {"ref": "āhnika 1 (opening verses)"}, "paraphrase": "How could we invent anything new? Let only the variety in the arrangement of words be judged here.", "tags": {"level": "unmarked", "standpoint": "seeker", "naya": null, "path": ["knowledge"], "stage": "all"}, "types": ["teacher-transmission"], "speaker": "Jayanta Bhaṭṭa", "notes": "Verse recalled from memory ('kuto vā nūtanaṃ vastu...'); position not checked.", "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U11-nyaya-vaisesika"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U11-nyaya-vaisesika"], "phases": ["skeleton"]}}
