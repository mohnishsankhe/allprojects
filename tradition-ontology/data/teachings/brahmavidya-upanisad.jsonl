{"id": "tea:brahmavidya-upanisad:12", "source": "src:brahmavidya-upanisad", "location": {"ref": "12"}, "paraphrase": "Like the sound of a bell fading into peace, the praṇava's end is to be meditated on; it leads to the supreme.", "tags": {"level": "bridging", "standpoint": "experiential", "naya": null, "path": ["sound", "meditation"], "stage": "advanced"}, "types": ["sound-language", "practice"], "practices": ["prc:pranava-dhyana"], "extraction": {"method": "skeleton", "extractors": [], "disagreements": []}, "verification": {"level": "sourced", "confidence": "moderate", "unverified": false, "checks": [{"phase": "C", "date": "2026-09-29", "method": "text-locate", "queries": ["e-text brahmavidya-upanisad 12"], "evidence": ["catalog:raw_etexts:108_Upanishads", "text:sources_raw/raw_etexts/vedaH/misc/upaniShat/mixedPF/108_Upanishads.md"], "result": "confirmed", "note": "E-text 12 located; the passage matches the paraphrase (it begins: 'kāṃsyaghaṇṭāninādastu yathā līyati śāntaye | oṅkā-rastu tathā yojyaḥ śāntaye sarvamicchatā || 12…').", "by": "sourcing:U04-minor-upanisads"}]}, "coverage": ["A2"], "provenance": {"units": ["skeleton:U04-minor-upanisads"], "phases": ["skeleton"]}}
