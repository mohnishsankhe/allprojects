{"id": "tea:lalita-trisati:secrecy", "source": "src:lalita-trisati", "location": {"ref": "secrecy"}, "paraphrase": "Hayagrīva calls the Triśatī the most secret of the Goddess's hymns and teaches it only after Agastya's persistent request, restricting it to the devoted and qualified.", "tags": {"level": "conventional", "standpoint": "divine", "naya": null, "path": ["general"], "stage": "all"}, "types": ["teacher-transmission"], "speaker": "Hayagrīva", "addressee": "Agastya", "concepts": ["cpt:srividya-secrecy"], "notes": "From memory of the frame story; not checked.", "reported_by_opponent": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": [], "disagreements": []}, "coverage": ["A8"], "verification": {"level": "skeleton", "confidence": "low", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U23-sakta-srividya"], "phases": ["skeleton"]}}
