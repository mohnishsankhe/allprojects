{"id": "tea:kundika-upanisad:1-8", "source": "src:kundika-upanisad", "location": {"ref": "1-8"}, "paraphrase": "After studentship, marriage and the forest, one renounces with the permission of kin; the fires are abandoned; he takes initiation and ochre, and the strainer to save creatures in water.", "tags": {"level": "conventional", "standpoint": "ritual", "naya": null, "path": ["ritual"], "stage": "advanced"}, "types": ["practice", "ethics"], "concepts": ["cpt:sannyasa-rite"], "practices": ["prc:sannyasa-diksa"], "extraction": {"method": "skeleton", "extractors": [], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "coverage": ["A2"], "provenance": {"units": ["skeleton:U04-minor-upanisads"], "phases": ["skeleton"]}}
{"id": "tea:kundika-upanisad:11-13", "source": "src:kundika-upanisad", "location": {"ref": "11-13"}, "paraphrase": "He wanders, lives on alms, sleeps on sand by rivers, is indifferent to praise and blame.", "tags": {"level": "conventional", "standpoint": "ethical-social", "naya": null, "path": ["general"], "stage": "advanced"}, "types": ["ethics"], "practices": ["prc:parivrajya"], "extraction": {"method": "skeleton", "extractors": [], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "low", "unverified": false, "checks": []}, "coverage": ["A2"], "provenance": {"units": ["skeleton:U04-minor-upanisads"], "phases": ["skeleton"]}}
{"id": "tea:kundika-upanisad:14-17", "source": "src:kundika-upanisad", "location": {"ref": "14-17"}, "paraphrase": "'I am the Lord, destroyer of hell and of the cities, the self of all, without a lord over me' — the renouncer's declaration of identity.", "tags": {"level": "ultimate", "standpoint": "absolute", "naya": null, "path": ["knowledge"], "stage": "advanced"}, "types": ["ultimate"], "extraction": {"method": "skeleton", "extractors": [], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "coverage": ["A2"], "provenance": {"units": ["skeleton:U04-minor-upanisads"], "phases": ["skeleton"]}}
{"id": "tea:kundika-upanisad:18-22-summary", "source": "src:kundika-upanisad", "location": {"ref": "18-22 (summary)"}, "paraphrase": "A yogic departure at death through the crown is described; recorded summary-only.", "tags": {"level": "ultimate", "standpoint": "absolute", "naya": null, "path": ["knowledge"], "stage": "advanced"}, "types": ["death-dying", "practice"], "concepts": ["cpt:yogic-exit-at-death"], "restricted": true, "extraction": {"method": "skeleton", "extractors": [], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "low", "unverified": false, "checks": []}, "coverage": ["A2"], "provenance": {"units": ["skeleton:U04-minor-upanisads"], "phases": ["skeleton"]}}
{"id": "tea:kundika-upanisad:23-28", "source": "src:kundika-upanisad", "location": {"ref": "23-28"}, "paraphrase": "The Self is the witness, untouched by the states and the body.", "tags": {"level": "ultimate", "standpoint": "absolute", "naya": null, "path": ["knowledge"], "stage": "advanced"}, "types": ["ultimate", "consciousness-mind"], "extraction": {"method": "skeleton", "extractors": [], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "low", "unverified": false, "checks": []}, "coverage": ["A2"], "provenance": {"units": ["skeleton:U04-minor-upanisads"], "phases": ["skeleton"]}}
{"id": "tea:kundika-upanisad:9-10", "source": "src:kundika-upanisad", "location": {"ref": "9-10"}, "paraphrase": "He may keep water-pot, drinking-bowl, sling, a three-legged stand, sandals, patched cloth, loincloth, strainer, bathing cloth and upper cloth, and should avoid anything beyond these.", "tags": {"level": "conventional", "standpoint": "ethical-social", "naya": null, "path": ["general"], "stage": "advanced"}, "types": ["ethics"], "concepts": ["cpt:renunciant-marks"], "differs_from": [{"target": "tea:katharudra-upanisad:1-2", "note": "Kaṭharudra tells the renouncer to abandon these same articles."}], "extraction": {"method": "skeleton", "extractors": [], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "coverage": ["A2"], "provenance": {"units": ["skeleton:U04-minor-upanisads"], "phases": ["skeleton"]}}
