{"id": "tea:aksi-upanisad:1", "source": "src:aksi-upanisad", "location": {"ref": "1"}, "paraphrase": "Sāṅkṛti goes to the sun's world and praises the Sun with the Cākṣuṣmatī-vidyā; one who knows it has no eye disease and none in his family is blind.", "tags": {"level": "conventional", "standpoint": "devotional", "naya": null, "path": ["devotion", "sound"], "stage": "all"}, "types": ["sound-language", "practice"], "practices": ["prc:caksusmati-vidya"], "teachers": ["tch:sankrti", "tch:aditya"], "extraction": {"method": "skeleton", "extractors": [], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "coverage": ["A2"], "provenance": {"units": ["skeleton:U04-minor-upanisads"], "phases": ["skeleton"]}}
