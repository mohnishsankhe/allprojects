{"id": "tea:tiruvacakam:1", "source": "src:tiruvacakam", "location": {"ref": "1", "section": "Civapurāṇam, lines 1–2"}, "paraphrase": "Praise to namaccivāya, praise to the feet of the Lord; praise to the feet of him who never leaves my heart even for the blink of an eye.", "tags": {"level": "conventional", "standpoint": "devotional", "naya": null, "path": ["devotion", "sound"], "stage": "all"}, "types": ["sound-language"], "original": {"text": "நமச்சிவாய வாஅழ்க நாதன்தாள் வாழ்க இமைப்பொழுதும் என்நெஞ்சில் நீங்காதான் தாள்வாழ்க", "script": "Tamil", "edition": "from memory; to be checked"}, "terms": ["trm:pancaksara"], "teachers": ["tch:manikkavacakar"], "reported_by_opponent": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U18-saiva-siddhanta"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U18-saiva-siddhanta"], "phases": ["skeleton"]}}
{"id": "tea:tiruvacakam:1/2", "source": "src:tiruvacakam", "location": {"ref": "1", "section": "Civapurāṇam, c. lines 26–32"}, "paraphrase": "Born as grass, shrub, worm, tree, many beasts, bird, snake, stone, man, demon, spirit, asura, sage and god — in every moving and unmoving birth I have been born and am weary; today, seeing your golden feet, I am freed.", "tags": {"level": "conventional", "standpoint": "experiential", "naya": null, "path": ["devotion"], "stage": "all"}, "types": ["karma-liberation"], "notes": "'pullāki pūṭāy puḻuvāy maramāki...'; line numbers approximate.", "reported_by_opponent": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U18-saiva-siddhanta"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U18-saiva-siddhanta"], "phases": ["skeleton"]}}
{"id": "tea:tiruvacakam:1/3", "source": "src:tiruvacakam", "location": {"ref": "1", "section": "Civapurāṇam"}, "paraphrase": "He is the one to whom the Vedas say 'not this, not this'; he came in grace as the guru, took me as his own, and cut my births.", "tags": {"level": "bridging", "standpoint": "divine", "naya": null, "path": ["devotion"], "stage": "all"}, "types": ["ultimate", "teacher-transmission"], "concepts": ["cpt:guru-as-siva"], "notes": "Reconstructed from the poem's themes; the exact wording and line not checked.", "reported_by_opponent": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U18-saiva-siddhanta"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "low", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U18-saiva-siddhanta"], "phases": ["skeleton"]}}
{"id": "tea:tiruvacakam:20", "source": "src:tiruvacakam", "location": {"ref": "20"}, "paraphrase": "Tiruppaḷḷiyeḻucci: the waking song, praising the Lord of Tirupperunturai at dawn as the gods throng to see him.", "tags": {"level": "conventional", "standpoint": "ritual", "naya": null, "path": ["devotion"], "stage": "all"}, "types": ["practice"], "notes": "Poem-level reference (10 verses).", "reported_by_opponent": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U18-saiva-siddhanta"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U18-saiva-siddhanta"], "phases": ["skeleton"]}}
{"id": "tea:tiruvacakam:3", "source": "src:tiruvacakam", "location": {"ref": "3"}, "paraphrase": "Tiruvaṇṭappakuti: the countless universes are like motes in a sunbeam before the Lord; he is inside and outside all, and he came to me, a mere dog, and made me his.", "tags": {"level": "ultimate", "standpoint": "cosmic", "naya": null, "path": ["devotion"], "stage": "all"}, "types": ["world-fate", "ultimate"], "notes": "Poem-level reference.", "reported_by_opponent": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U18-saiva-siddhanta"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "low", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U18-saiva-siddhanta"], "phases": ["skeleton"]}}
{"id": "tea:tiruvacakam:35", "source": "src:tiruvacakam", "location": {"ref": "35"}, "paraphrase": "Accappattu: I do not fear the snake in the anthill, nor the false ones' sweet words; I fear only those who do not think of the Lord who wears the crescent.", "tags": {"level": "conventional", "standpoint": "devotional", "naya": null, "path": ["devotion"], "stage": "all"}, "types": ["ethics"], "notes": "Poem number and paraphrase moderate confidence.", "reported_by_opponent": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U18-saiva-siddhanta"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U18-saiva-siddhanta"], "phases": ["skeleton"]}}
{"id": "tea:tiruvacakam:5", "source": "src:tiruvacakam", "location": {"ref": "5"}, "paraphrase": "Tiruccatakam: the devotee weeps and melts, his hair stands on end, he dances and sings — yet laments that his heart has not melted enough; the melting of the heart is the sign of grace.", "tags": {"level": "conventional", "standpoint": "experiential", "naya": null, "path": ["devotion"], "stage": "all"}, "types": ["powers-experiences"], "notes": "Poem-level reference.", "cross_refs": ["tea:tiruvacakam:1"], "reported_by_opponent": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U18-saiva-siddhanta"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U18-saiva-siddhanta"], "phases": ["skeleton"]}}
{"id": "tea:tiruvacakam:7", "source": "src:tiruvacakam", "location": {"ref": "7"}, "paraphrase": "Tiruvempāvai: young women wake one another before dawn in the month of Mārkaḻi to bathe and sing Śiva's praise, and pray for husbands who are his devotees.", "tags": {"level": "conventional", "standpoint": "devotional", "naya": null, "path": ["devotion", "ritual"], "stage": "all"}, "types": ["practice"], "practices": ["prc:tiruvempavai-vow"], "notes": "Poem-level reference (20 verses).", "reported_by_opponent": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U18-saiva-siddhanta"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U18-saiva-siddhanta"], "phases": ["skeleton"]}}
