{"id": "tea:vedanta-parijata-saurabha:3.2.27", "source": "src:vedanta-parijata-saurabha", "location": {"ref": "3.2.27"}, "paraphrase": "Because scripture teaches both, the relation of the non-conscious world to Brahman is like that of the snake to its coils: difference and non-difference both hold.", "tags": {"level": "ultimate", "standpoint": "analytic", "naya": null, "path": ["knowledge"], "stage": "all"}, "types": ["ultimate"], "coverage": ["A6"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U16-bhedabheda"], "disagreements": []}, "teachers": ["tch:nimbarka"], "concepts": ["cpt:svabhavika-bhedabheda", "cpt:bhedabheda"], "terms": ["trm:svabhavika-bhedabheda"], "disputes": ["dsp:aupadhika-vs-svabhavika-bhedabheda"], "notes": "BS 3.2.27 (ahikuṇḍalavat) is the school's key sūtra; the next sūtras (light and its source) are also read as bhedābheda.", "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U16-bhedabheda"], "phases": ["skeleton"]}}
