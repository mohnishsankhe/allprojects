{"id": "tea:sutrapath:acara.caste", "source": "src:sutrapath", "location": {"ref": "Ācāra section"}, "paraphrase": "Among those who seek Parameśvara caste does not count; women and people of any birth may take renunciation.", "tags": {"level": "conventional", "standpoint": "ethical-social", "naya": null, "path": ["devotion"], "stage": "all"}, "types": ["ethics", "dispute"], "teachers": ["tch:cakradhar"], "concepts": ["cpt:bhakti-and-caste"], "disputes": ["dsp:women-caste-liberation", "dsp:mahanubhava-and-the-devatas"], "coverage": ["I2"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U26-regional-bhakti"], "disagreements": []}, "notes": "Position well attested for the order; exact sūtra not recalled.", "verification": {"level": "skeleton", "confidence": "low", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U26-regional-bhakti"], "phases": ["skeleton"]}}
{"id": "tea:sutrapath:acara.renunciant", "source": "src:sutrapath", "location": {"ref": "Ācāra section"}, "paraphrase": "The renunciant should not stay long in one place, should live by begging, harm not even the smallest creature, keep no possessions, avoid worldly company and stay absorbed in remembrance of the Lord.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["devotion", "action"], "stage": "intermediate"}, "types": ["ethics", "practice"], "teachers": ["tch:cakradhar"], "practices": ["prc:mahanubhava-renunciant-discipline"], "concepts": ["cpt:mahanubhava-renunciation"], "terms": ["trm:atana", "trm:bhiksa", "trm:ahimsa"], "coverage": ["I2"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U26-regional-bhakti"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "low", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U26-regional-bhakti"], "phases": ["skeleton"]}}
{"id": "tea:sutrapath:vicara.devatas", "source": "src:sutrapath", "location": {"ref": "Vicāra section"}, "paraphrase": "The devatās can give only worldly fruit and are themselves in bondage; whoever seeks liberation must not worship them but take refuge in Parameśvara alone.", "tags": {"level": "conventional", "standpoint": "polemical", "naya": null, "path": ["devotion"], "stage": "all"}, "types": ["ultimate", "dispute"], "teachers": ["tch:cakradhar"], "concepts": ["cpt:devatas-mahanubhava"], "obstacles": ["obs:devatantara-bhajana"], "disputes": ["dsp:mahanubhava-and-the-devatas"], "coverage": ["I2"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U26-regional-bhakti"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "low", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U26-regional-bhakti"], "phases": ["skeleton"]}}
{"id": "tea:sutrapath:vicara.four-realities", "source": "src:sutrapath", "location": {"ref": "Vicāra section (sūtra numbers not recalled)"}, "paraphrase": "There are four eternal and distinct realities: souls (jīva), countless and bound by ignorance; deities (devatā), powerful but bound; the world (prapañca), made of māyā; and Parameśvara, the one Supreme, who alone liberates.", "tags": {"level": "ultimate", "standpoint": "analytic", "naya": null, "path": ["knowledge", "devotion"], "stage": "all"}, "types": ["ultimate"], "teachers": ["tch:cakradhar"], "concepts": ["cpt:four-realities-mahanubhava"], "terms": ["trm:paramesvara", "trm:devata", "trm:prapanca", "trm:jiva"], "coverage": ["I2"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U26-regional-bhakti"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "low", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U26-regional-bhakti"], "phases": ["skeleton"]}}
