{"id": "tea:nyayasara:moksa", "source": "src:nyayasara", "location": {"ref": "āgama chapter (on liberation)"}, "paraphrase": "Liberation is the absolute cessation of pain qualified by the experience of eternal pleasure.", "tags": {"level": "unmarked", "standpoint": "polemical", "naya": null, "path": ["knowledge"], "stage": "unmarked"}, "types": ["karma-liberation", "dispute"], "speaker": "Bhāsarvajña", "terms": ["trm:moksa", "trm:sukha"], "concepts": ["cpt:apavarga-nyaya"], "disputes": ["dsp:bliss-in-liberation"], "differs_from": [{"target": "tea:nyaya-bhasya:1.1.22", "note": "Vātsyāyana rejects eternal pleasure in liberation."}], "notes": "Definition recalled from memory; defended at length in the Nyāyabhūṣaṇa.", "coverage": ["A5", "D", "G"], "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U11-nyaya-vaisesika"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U11-nyaya-vaisesika"], "phases": ["skeleton"]}}
