{"id": "tea:naladiyar:adh.1", "source": "src:naladiyar", "location": {"ref": "adh.1"}, "paraphrase": "Wealth is impermanent: it comes and goes like the turning of a cart-wheel; share what you have while you have it, for it will not stay.", "tags": {"level": "conventional", "standpoint": "ethical-social", "naya": null, "path": ["general"], "stage": "all"}, "types": ["ethics"], "obstacles": ["obs:parigraha"], "concepts": ["cpt:twelve-anupreksas"], "terms": ["trm:aram"], "notes": "Chapter-level paraphrase ('the impermanence of wealth'); the cart-wheel image recalled with moderate confidence.", "reported_by_opponent": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U34-jain-canon"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U34-jain-canon"], "phases": ["skeleton"]}}
