{"id": "tea:naladiyar:adh.6", "source": "src:naladiyar", "location": {"ref": "adh.6"}, "paraphrase": "Renunciation: the wise, seeing the body's impurity and the world's transience, give up attachment and take up austerity; those who renounce are freed from the sorrow of births.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["action"], "stage": "intermediate"}, "types": ["practice", "karma-liberation"], "terms": ["trm:turavu"], "notes": "Chapter-level paraphrase; chapter number low confidence.", "reported_by_opponent": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U34-jain-canon"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "low", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U34-jain-canon"], "phases": ["skeleton"]}}
