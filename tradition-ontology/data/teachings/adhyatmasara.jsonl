{"id": "tea:adhyatmasara:vairagya", "source": "src:adhyatmasara", "location": {"ref": "vairagya", "section": null}, "paraphrase": "Detachment is threefold: born of suffering, born of delusion, and born of knowledge; only the last is true and lasting.", "tags": {"level": "conventional", "standpoint": "analytic", "naya": null, "path": ["general"], "stage": "all"}, "types": ["practice", "consciousness-mind"], "terms": ["trm:vairagya"], "concepts": ["cpt:three-vairagyas"], "teachers": ["tch:yasovijaya"], "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U35-jain-philosophy"], "disagreements": []}, "correction_log": [], "notes": "Section-level ref.", "coverage": ["B2"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U35-jain-philosophy"], "phases": ["skeleton"]}}
{"id": "tea:adhyatmasara:yoga", "source": "src:adhyatmasara", "location": {"ref": "yoga", "section": null}, "paraphrase": "Yoga is of two kinds, action-yoga and knowledge-yoga; action purifies and supports knowledge, and knowledge makes action fruitful; the adept rests in knowledge while action falls away of itself.", "tags": {"level": "bridging", "standpoint": "seeker", "naya": null, "path": ["action", "knowledge"], "stage": "all"}, "types": ["practice"], "concepts": ["cpt:niscaya-vyavahara"], "teachers": ["tch:yasovijaya"], "disputes": ["dsp:jnana-karma-samuccaya"], "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U35-jain-philosophy"], "disagreements": []}, "correction_log": [], "notes": "Section-level ref.", "coverage": ["B2"], "verification": {"level": "skeleton", "confidence": "low", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U35-jain-philosophy"], "phases": ["skeleton"]}}
