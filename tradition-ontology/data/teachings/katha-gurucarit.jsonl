{"id": "tea:katha-gurucarit:madhavadeva-conversion", "source": "src:katha-gurucarit", "location": {"ref": "episode of Mādhavadeva's meeting"}, "paraphrase": "Mādhavadeva, a worshipper of the Goddess, came to argue with Śaṅkaradeva over a goat vowed for sacrifice; after long debate Śaṅkaradeva cited the Bhāgavata — as watering the root of a tree nourishes trunk, branches and leaves, so worshipping Acyuta satisfies all the gods — and Mādhavadeva took refuge as his disciple.", "tags": {"level": "conventional", "standpoint": "polemical", "naya": null, "path": ["devotion"], "stage": "all"}, "types": ["dispute", "narrative"], "teachers": ["tch:sankaradeva", "tch:madhavadeva"], "disputes": ["dsp:ekasarana-and-other-deities"], "concepts": ["cpt:ekasarana"], "cross_refs": ["tea:bhagavata-purana:4.31.14"], "coverage": ["I2"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U26-regional-bhakti"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U26-regional-bhakti"], "phases": ["skeleton"]}}
