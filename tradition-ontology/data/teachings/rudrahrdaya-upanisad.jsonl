{"id": "tea:rudrahrdaya-upanisad:1-5", "source": "src:rudrahrdaya-upanisad", "location": {"ref": "1-5"}, "paraphrase": "Śuka asks Vyāsa which god is the self of all gods; Vyāsa: Rudra; Umā is Viṣṇu; one who bows to Govinda bows to Śaṅkara; one who hates Virūpākṣa hates Janārdana; the union of Umā and Śaṅkara is Viṣṇu.", "tags": {"level": "conventional", "standpoint": "divine", "naya": null, "path": ["devotion"], "stage": "all"}, "types": ["ultimate", "dispute"], "concepts": ["cpt:siva-visnu-identity"], "disputes": ["dsp:which-deity-is-supreme"], "teachers": ["tch:suka", "tch:vyasa"], "extraction": {"method": "skeleton", "extractors": [], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "coverage": ["A2"], "provenance": {"units": ["skeleton:U04-minor-upanisads"], "phases": ["skeleton"]}}
