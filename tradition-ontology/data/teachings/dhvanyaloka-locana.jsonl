{"id": "tea:dhvanyaloka-locana:1.5", "source": "src:dhvanyaloka-locana", "location": {"ref": "1.5", "chapter": "1", "verse": "5"}, "paraphrase": "Abhinavagupta: the grief of the first poet was not his personal sorrow — had it been, he would only have suffered; the stable emotion of grief, relished through the determinants (the slain bird, the lamenting mate), became the rasa of compassion, which overflowed as verse; hence rasa is the soul of poetry.", "tags": {"level": "conventional", "standpoint": "experiential", "naya": null, "path": ["general"], "stage": "all"}, "types": ["consciousness-mind", "sound-language"], "teachers": ["tch:abhinavagupta"], "concepts": ["cpt:rasa-as-relish-of-consciousness"], "commentary_on": "tea:dhvanyaloka:1.5", "notes": "Paraphrase from memory.", "reported_by_opponent": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U31-sound-arts"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U31-sound-arts"], "phases": ["skeleton"]}}
