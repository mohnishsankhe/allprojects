{"id": "tea:tukaram-gatha:amha-ghari-dhana", "source": "src:tukaram-gatha", "location": {"ref": "abhaṅga 'āmhāṃ gharīṃ dhana'"}, "paraphrase": "In our house the wealth is jewels of words; with weapons of words we strive; words are the life of our life, and this wealth we share among the people.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["sound"], "stage": "all"}, "types": ["sound-language"], "original": {"text": "आम्हां घरीं धन शब्दांचीं रत्नें । शब्दांचींच शस्त्रें यत्न करूं ॥", "script": "Devanāgarī", "edition": "recalled from memory; to be checked against a printed edition", "licence": "public domain (pre-1900 text)"}, "teachers": ["tch:tukaram"], "concepts": ["cpt:vernacular-as-sacred-speech"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U26-regional-bhakti"], "disagreements": []}, "coverage": ["A9"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U26-regional-bhakti"], "phases": ["skeleton"]}}
{"id": "tea:tukaram-gatha:amhi-jato-apulya-gava", "source": "src:tukaram-gatha", "location": {"ref": "abhaṅga 'āmhī jātoṃ āpulyā gāṃvā'"}, "paraphrase": "We are going to our own village; take our 'Rām Rām' — our farewell.", "tags": {"level": "conventional", "standpoint": "experiential", "naya": null, "path": ["devotion"], "stage": "realized"}, "types": ["death-dying"], "original": {"text": "आम्ही जातों आपुल्या गांवा । आमुचा राम राम घ्यावा ॥", "script": "Devanāgarī", "edition": "recalled from memory; to be checked against a printed edition", "licence": "public domain (pre-1900 text)"}, "teachers": ["tch:tukaram"], "concepts": ["cpt:bodily-departure-of-saints"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U26-regional-bhakti"], "disagreements": []}, "coverage": ["A9"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U26-regional-bhakti"], "phases": ["skeleton"]}}
