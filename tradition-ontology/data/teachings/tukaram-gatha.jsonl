{"id": "tea:tukaram-gatha:nahi-nirmala-jivana", "source": "src:tukaram-gatha", "location": {"ref": "abhaṅga 'nāhīṃ nirmaḷa jīvana'"}, "paraphrase": "If the life within is not pure, what will soap do? Outward cleansing without inner purity is useless.", "tags": {"level": "conventional", "standpoint": "polemical", "naya": null, "path": ["general"], "stage": "all"}, "types": ["ethics"], "teachers": ["tch:tukaram"], "obstacles": ["obs:dambha"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U26-regional-bhakti"], "disagreements": []}, "coverage": ["A9"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U26-regional-bhakti"], "phases": ["skeleton"]}}
{"id": "tea:tukaram-gatha:namasankirtana-sadhana", "source": "src:tukaram-gatha", "location": {"ref": "abhaṅga 'nāmasaṅkīrtana sādhana paiṃ sopeṃ'"}, "paraphrase": "The singing of the name is an easy means; it burns away the sins of many births; there is no need to toil or go to the forest — the Lord comes gladly to your house.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["sound", "devotion"], "stage": "all"}, "types": ["practice", "karma-liberation"], "original": {"text": "नामसंकीर्तन साधन पैं सोपें । जळतील पापें जन्मांतरींचीं ॥", "script": "Devanāgarī", "edition": "recalled from memory; to be checked against a printed edition", "licence": "public domain (pre-1900 text)"}, "teachers": ["tch:tukaram"], "concepts": ["cpt:divine-name", "cpt:householder-devotion"], "practices": ["prc:nama-sankirtana"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U26-regional-bhakti"], "disagreements": []}, "coverage": ["A9"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U26-regional-bhakti"], "phases": ["skeleton"]}}
{"id": "tea:tukaram-gatha:sukha-pahata", "source": "src:tukaram-gatha", "location": {"ref": "abhaṅga 'sukha pāhatāṃ javāpāḍeṃ'"}, "paraphrase": "Happiness, when you look at it, is the size of a barley grain; sorrow is as big as a mountain.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["knowledge"], "stage": "beginner"}, "types": ["world-fate"], "original": {"text": "सुख पाहतां जवापाडें । दुःख पर्वताएवढें ॥", "script": "Devanāgarī", "edition": "recalled from memory; to be checked against a printed edition", "licence": "public domain (pre-1900 text)"}, "teachers": ["tch:tukaram"], "concepts": ["cpt:vairagya"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U26-regional-bhakti"], "disagreements": []}, "coverage": ["A9"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U26-regional-bhakti"], "phases": ["skeleton"]}}
{"id": "tea:tukaram-gatha:sundara-te-dhyana", "source": "src:tukaram-gatha", "location": {"ref": "abhaṅga 'sundara teṃ dhyāna'"}, "paraphrase": "Beautiful is that form to meditate on — standing on the brick, hands resting on the hips, the tuḷsī garland at his neck; this form is my delight.", "tags": {"level": "conventional", "standpoint": "devotional", "naya": null, "path": ["devotion", "meditation"], "stage": "all"}, "types": ["practice"], "original": {"text": "सुंदर तें ध्यान उभें विटेवरी । कर कटावरी ठेवोनियां ॥", "script": "Devanāgarī", "edition": "recalled from memory; to be checked against a printed edition", "licence": "public domain (pre-1900 text)"}, "teachers": ["tch:tukaram"], "concepts": ["cpt:vitthala-of-pandharpur"], "practices": ["prc:rupa-dhyana"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U26-regional-bhakti"], "disagreements": []}, "coverage": ["A9"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U26-regional-bhakti"], "phases": ["skeleton"]}}
