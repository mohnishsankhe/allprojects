{"id": "tea:tukaram-gatha:vedanca-artha", "source": "src:tukaram-gatha", "location": {"ref": "abhaṅga 'vedāṃcā to artha'"}, "paraphrase": "We alone know the meaning of the Vedas; the others merely carry their burden on their heads.", "tags": {"level": "conventional", "standpoint": "polemical", "naya": null, "path": ["devotion"], "stage": "all"}, "types": ["dispute"], "original": {"text": "वेदांचा तो अर्थ आम्हांसीच ठावा । येरांनीं वहावा भार माथा ॥", "script": "Devanāgarī", "edition": "recalled from memory; to be checked against a printed edition", "licence": "public domain (pre-1900 text)"}, "teachers": ["tch:tukaram"], "disputes": ["dsp:caste-and-the-varkari-saints", "dsp:status-of-veda"], "concepts": ["cpt:bhakti-and-caste"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U26-regional-bhakti"], "disagreements": []}, "coverage": ["A9"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U26-regional-bhakti"], "phases": ["skeleton"]}}
