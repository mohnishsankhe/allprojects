{"id": "tea:tukaram-gatha:bare-deva-kunbi", "source": "src:tukaram-gatha", "location": {"ref": "abhaṅga 'bareṃ devā kuṇabī keloṃ'"}, "paraphrase": "It is well, God, that you made me a Kuṇbī; otherwise I would have died of pride.", "tags": {"level": "conventional", "standpoint": "devotional", "naya": null, "path": ["devotion"], "stage": "all"}, "types": ["ethics", "dispute"], "original": {"text": "बरें देवा कुणबी केलों । नाहीं तरि दंभें असतों मेलों ॥", "script": "Devanāgarī", "edition": "recalled from memory; to be checked against a printed edition", "licence": "public domain (pre-1900 text)"}, "teachers": ["tch:tukaram"], "obstacles": ["obs:dambha", "obs:jati-abhimana"], "concepts": ["cpt:bhakti-and-caste"], "disputes": ["dsp:caste-and-the-varkari-saints"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U26-regional-bhakti"], "disagreements": []}, "coverage": ["A9"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U26-regional-bhakti"], "phases": ["skeleton"]}}
{"id": "tea:tukaram-gatha:heci-dana-dega", "source": "src:tukaram-gatha", "location": {"ref": "abhaṅga 'heṃci dāna degā devā'"}, "paraphrase": "Give me only this gift, O God: that I never forget you. I will sing your qualities with love — that is all my wealth; I need neither liberation nor riches — give me always the company of the saints.", "tags": {"level": "conventional", "standpoint": "devotional", "naya": null, "path": ["devotion"], "stage": "all"}, "types": ["karma-liberation"], "original": {"text": "हेंचि दान देगा देवा । तुझा विसर न व्हावा ॥", "script": "Devanāgarī", "edition": "recalled from memory; to be checked against a printed edition", "licence": "public domain (pre-1900 text)"}, "teachers": ["tch:tukaram"], "concepts": ["cpt:desirelessness-for-mukti"], "practices": ["prc:satsanga"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U26-regional-bhakti"], "disagreements": []}, "coverage": ["A9"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U26-regional-bhakti"], "phases": ["skeleton"]}}
{"id": "tea:tukaram-gatha:je-ka-ranjale-ganjale", "source": "src:tukaram-gatha", "location": {"ref": "abhaṅga 'je kā raṃjale gāṃjale'"}, "paraphrase": "Whoever calls the afflicted and the oppressed his own — know him for a sādhu; know that God is there.", "tags": {"level": "conventional", "standpoint": "ethical-social", "naya": null, "path": ["devotion", "action"], "stage": "all"}, "types": ["ethics"], "original": {"text": "जे का रंजले गांजले । त्यासि म्हणे जो आपुलें ॥ तो चि साधु ओळखावा । देव तेथें चि जाणावा ॥", "script": "Devanāgarī", "edition": "recalled from memory; to be checked against a printed edition", "licence": "public domain (pre-1900 text)"}, "teachers": ["tch:tukaram"], "concepts": ["cpt:marks-of-the-saint"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U26-regional-bhakti"], "disagreements": []}, "coverage": ["A9"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U26-regional-bhakti"], "phases": ["skeleton"]}}
