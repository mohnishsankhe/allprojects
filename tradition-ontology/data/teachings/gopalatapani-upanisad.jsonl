{"id": "tea:gopalatapani-upanisad:1.1", "source": "src:gopalatapani-upanisad", "location": {"ref": "1.1"}, "paraphrase": "Salutation to Kṛṣṇa, whose form is being, consciousness and bliss, who acts without effort, who is known through Vedānta, the guru and the witness of the intellect.", "tags": {"level": "ultimate", "standpoint": "devotional", "naya": null, "path": ["devotion"], "stage": "all"}, "types": ["ultimate"], "coverage": ["A2", "A6"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U16-bhedabheda"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U16-bhedabheda"], "phases": ["skeleton"]}}
