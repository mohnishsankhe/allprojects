{"id": "tea:kirtana-ghosa:namaparadha", "source": "src:kirtana-ghosa", "location": {"ref": "Nāmāparādha section"}, "paraphrase": "The section on offences against the name warns against slighting devotees, holding other gods equal to Kṛṣṇa and sinning on the name's strength — yet the name itself, sung constantly, removes even these offences.", "tags": {"level": "conventional", "standpoint": "seeker", "naya": null, "path": ["sound"], "stage": "all"}, "types": ["practice", "ethics"], "teachers": ["tch:sankaradeva"], "obstacles": ["obs:nama-aparadha"], "concepts": ["cpt:divine-name"], "coverage": ["I2"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U26-regional-bhakti"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "low", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U26-regional-bhakti"], "phases": ["skeleton"]}}
