{"id": "tea:kirtana-ghosa:1", "source": "src:kirtana-ghosa", "location": {"ref": "opening verse"}, "paraphrase": "First I bow to the eternal one whose form is Brahman, Nārāyaṇa, the cause of all the avatāras.", "tags": {"level": "ultimate", "standpoint": "devotional", "naya": null, "path": ["devotion"], "stage": "all"}, "types": ["ultimate"], "teachers": ["tch:sankaradeva"], "concepts": ["cpt:ekasarana", "cpt:avatara"], "coverage": ["I2"], "reported_by_opponent": false, "ai_translated": false, "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U26-regional-bhakti"], "disagreements": []}, "notes": "Opening recalled as 'prathame praṇāmo brahmarūpī sanātana'; wording to verify.", "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U26-regional-bhakti"], "phases": ["skeleton"]}}
