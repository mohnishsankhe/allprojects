{"id": "tea:kanninun-ciruttampu:2", "source": "src:kanninun-ciruttampu", "location": {"ref": "2"}, "paraphrase": "I know no other god; singing the sweet melody of the verses of the Nampi of Kurukūr, I shall wander.", "tags": {"level": "conventional", "standpoint": "devotional", "naya": null, "path": ["devotion", "sound"], "stage": "all"}, "types": ["teacher-transmission"], "speaker": "Madhurakavi Āḻvār", "teachers": ["tch:madhurakavi-alvar", "tch:nammalvar"], "concepts": ["cpt:acarya-nistha"], "practices": ["prc:guru-bhakti", "prc:kirtana"], "notes": "'tēvu maṟṟaṟiyēṉ'.", "coverage": ["A9"], "reported_by_opponent": false, "ai_translated": false, "translation_basis": "skeleton paraphrase from model knowledge of the text; not made from an edition", "fidelity": {"status": "unchecked"}, "extraction": {"method": "skeleton", "extractors": ["U25-alvar-bhakti-theory"], "disagreements": []}, "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "provenance": {"units": ["skeleton:U25-alvar-bhakti-theory"], "phases": ["skeleton"]}}
