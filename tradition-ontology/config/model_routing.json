{
  "_note": "Product runtime routing. Change models or effort here without code edits. Rules run first wherever a step has a rule layer; the model runs second and its output always passes the deterministic validators.",
  "base_url_env": "ONTO_ANTHROPIC_BASE_URL",
  "default_base_url": "https://api.anthropic.com",
  "api_key_env": "ANTHROPIC_API_KEY",
  "timeout_seconds": 90,
  "max_retries": 3,
  "fallbacks": {"enabled": true, "beta": "server-side-fallback-2026-07-01", "mode": "default"},
  "steps": {
    "safety_screen":   {"model": "claude-opus-5-5",   "effort": "high",   "max_tokens": 2000,  "runs_first": true},
    "intake_parse":    {"model": "claude-sonnet-5-5", "effort": "high",   "max_tokens": 4000},
    "candidate_map":   {"model": "claude-sonnet-5-5", "effort": "high",   "max_tokens": 6000},
    "synthesis":       {"model": "claude-opus-5-5",   "effort": "high",   "premium_effort": "xhigh", "max_tokens": 12000},
    "pathway":         {"model": "claude-sonnet-5-5", "effort": "high",   "max_tokens": 6000,  "rules_first": true},
    "content_draft":   {"model": "claude-sonnet-5-5", "effort": "medium", "max_tokens": 6000},
    "content_check":   {"model": "claude-opus-5-5",   "effort": "high",   "max_tokens": 4000}
  }
}
