{"id": "trm:kaki", "term": "kākī (mudrā)", "language": "Sanskrit", "definitions": [{"lineage": "lin:hatha-yoga", "definition": "Drinking air slowly through the mouth shaped like a crow's beak (kākacañcu).", "sources": ["src:gheranda-samhita", "src:siva-samhita"], "rests_on": ["tea:gheranda-samhita:3.86-87", "tea:siva-samhita:3.68-83"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "native": "काकी", "literal": "the crow's (seal)", "related": [], "concepts": [], "coverage": ["E", "A10"]}
