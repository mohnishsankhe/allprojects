{"id": "trm:dhauti", "term": "dhauti", "language": "Sanskrit", "definitions": [{"lineage": "lin:hatha-yoga", "definition": "The first of the six cleansing acts: in the HYP the swallowing and withdrawing of a moistened cloth; in the GS a class of four kinds (inner, of the teeth, of the heart, of the root) with their variants.", "sources": ["src:hatha-yoga-pradipika", "src:gheranda-samhita"], "rests_on": ["tea:hatha-yoga-pradipika:2.24-25", "tea:gheranda-samhita:1.13-14"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "native": "धौति", "literal": "washing", "related": ["trm:satkarma"], "concepts": ["cpt:satkarma-doctrine"], "coverage": ["E", "A10"]}
{"id": "trm:basti", "term": "basti / vasti", "language": "Sanskrit", "definitions": [{"lineage": "lin:hatha-yoga", "definition": "The second cleansing act: washing the colon by drawing in water while squatting in navel-deep water (jala-basti); the GS adds a 'dry' basti on the ground.", "sources": ["src:hatha-yoga-pradipika", "src:gheranda-samhita"], "rests_on": ["tea:hatha-yoga-pradipika:2.26-28", "tea:gheranda-samhita:1.45-47", "tea:gheranda-samhita:1.48-49"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "native": "बस्ति", "literal": "bladder; enema", "related": ["trm:satkarma"], "concepts": [], "coverage": ["E", "A10"]}
{"id": "trm:neti", "term": "neti", "language": "Sanskrit", "definitions": [{"lineage": "lin:hatha-yoga", "definition": "The cleansing act of passing a fine thread in through a nostril and out through the mouth.", "sources": ["src:hatha-yoga-pradipika", "src:gheranda-samhita"], "rests_on": ["tea:hatha-yoga-pradipika:2.29-30", "tea:gheranda-samhita:1.50-51"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "native": "नेति", "literal": "(the act of) leading (through)", "related": ["trm:satkarma"], "concepts": [], "coverage": ["E", "A10"]}
{"id": "trm:trataka", "term": "trāṭaka", "language": "Sanskrit", "definitions": [{"lineage": "lin:hatha-yoga", "definition": "Gazing without blinking at a small target until tears fall; one of the six acts, and in the GS a way to śāmbhavī.", "sources": ["src:hatha-yoga-pradipika", "src:gheranda-samhita"], "rests_on": ["tea:hatha-yoga-pradipika:2.31-32", "tea:gheranda-samhita:1.53-54"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "native": "त्राटक", "literal": "fixed gazing", "related": ["trm:satkarma", "trm:sambhavi", "trm:drsti"], "concepts": [], "coverage": ["E", "A10"]}
{"id": "trm:nauli", "term": "nauli / laulikī", "language": "Sanskrit", "definitions": [{"lineage": "lin:hatha-yoga", "definition": "The cleansing act of turning the belly rapidly to right and left with the shoulders bent; called laulikī in the GS and 'the crown of the haṭha practices' in the HYP.", "sources": ["src:hatha-yoga-pradipika", "src:gheranda-samhita"], "rests_on": ["tea:hatha-yoga-pradipika:2.33-34", "tea:gheranda-samhita:1.52"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "native": "नौलि", "literal": "(from nala, 'tube') / 'rolling'", "related": ["trm:satkarma"], "concepts": [], "coverage": ["E", "A10"]}
{"id": "trm:kapalabhati", "term": "kapālabhāti / bhālabhāti", "language": "Sanskrit", "definitions": [{"lineage": "lin:hatha-yoga", "definition": "In the HYP rapid exhalation and inhalation like bellows, drying up phlegm; in the GS a threefold act (vāmakrama with the breath, vyutkrama and śītkrama with water).", "sources": ["src:hatha-yoga-pradipika", "src:gheranda-samhita"], "rests_on": ["tea:hatha-yoga-pradipika:2.35", "tea:gheranda-samhita:1.55-57", "tea:gheranda-samhita:1.58", "tea:gheranda-samhita:1.59-60"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "native": "कपालभाति", "literal": "skull-shining / forehead-shining", "related": ["trm:satkarma"], "concepts": [], "coverage": ["E", "A10"]}
