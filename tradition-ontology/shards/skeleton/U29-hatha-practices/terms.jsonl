{"id": "trm:dardura", "term": "dardurī / dārdurī", "language": "Sanskrit", "definitions": [{"lineage": "lin:hatha-yoga", "definition": "The sign of the middle grade of breath-mastery in which the seated yogin moves about in hops like a frog, before rising from the ground.", "sources": ["src:siva-samhita", "src:dattatreyayogasastra"], "rests_on": ["tea:siva-samhita:3.40-46", "tea:dattatreyayogasastra:69-76"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "native": "दर्दुरी", "literal": "frog-like (movement)", "related": [], "concepts": ["cpt:signs-of-pranayama"], "coverage": ["E", "A10"]}
{"id": "trm:rajadanta", "term": "rājadanta", "language": "Sanskrit", "definitions": [{"lineage": "lin:hatha-yoga", "definition": "The front teeth, at whose root the tongue is pressed in some forms of padmāsana and mahābandha (HYP 1.46, 3.22; GŚ 64; ŚS 3.73).", "sources": ["src:hatha-yoga-pradipika", "src:siva-samhita"], "rests_on": ["tea:hatha-yoga-pradipika:1.45-47", "tea:hatha-yoga-pradipika:3.22", "tea:siva-samhita:3.68-83"]}], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "native": "राजदन्त", "literal": "the royal tooth (front teeth)", "related": [], "concepts": [], "coverage": ["E", "A10"]}
{"id": "trm:lambika", "term": "lambikā", "language": "Sanskrit", "definitions": [{"lineage": "lin:hatha-yoga", "definition": "The uvula or the region of the palate above which the tongue is inserted in khecarī; also used of the tongue itself when lengthened (GS 1.29-32).", "sources": ["src:hatha-yoga-pradipika", "src:gheranda-samhita", "src:siva-samhita"], "rests_on": ["tea:hatha-yoga-pradipika:3.42-43", "tea:gheranda-samhita:1.29-32", "tea:siva-samhita:4.31-37"]}], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "native": "लम्बिका", "literal": "the hanging one (the uvula / soft palate)", "related": ["trm:khecari"], "concepts": [], "coverage": ["E", "A10"]}
{"id": "trm:kapalakuhara", "term": "kapāla-kuhara", "language": "Sanskrit", "definitions": [{"lineage": "lin:hatha-yoga", "definition": "The cavity above the palate into which the reversed tongue enters in khecarī.", "sources": ["src:hatha-yoga-pradipika", "src:gheranda-samhita", "src:goraksasataka"], "rests_on": ["tea:hatha-yoga-pradipika:3.32", "tea:gheranda-samhita:3.25-32", "tea:goraksasataka:34"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "native": "कपालकुहर", "literal": "the cavity of the skull", "related": ["trm:khecari"], "concepts": [], "coverage": ["E", "A10"]}
{"id": "trm:vyomacakra", "term": "vyomacakra", "language": "Sanskrit", "definitions": [{"lineage": "lin:hatha-yoga", "definition": "The HYP's name for the place where the reversed tongue meets the junction of the three paths in khecarī, and for the space between sun and moon where the inner khecarī abides.", "sources": ["src:hatha-yoga-pradipika"], "rests_on": ["tea:hatha-yoga-pradipika:3.37-40", "tea:hatha-yoga-pradipika:4.43-45"]}], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "native": "व्योमचक्र", "literal": "the wheel of space", "related": ["trm:khecari"], "concepts": [], "coverage": ["E", "A10"]}
{"id": "trm:chedana", "term": "chedana", "language": "Sanskrit", "definitions": [{"lineage": "lin:hatha-yoga", "definition": "The cutting of the tongue's frenum prescribed, together with 'moving' (cālana) and 'milking' (dohana), in the preparation for khecarī. RESTRICTED: recorded as a term only; the procedure is not reproduced.", "sources": ["src:hatha-yoga-pradipika"], "rests_on": ["tea:hatha-yoga-pradipika:3.33-36"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "native": "छेदन", "literal": "cutting", "related": ["trm:khecari"], "concepts": [], "coverage": ["E", "A10"]}
{"id": "trm:pratika", "term": "pratīka", "language": "Sanskrit", "definitions": [{"lineage": "lin:hatha-yoga", "definition": "In the ŚS's pratīkopāsana, one's own reflected image seen first in sunlight and then in the sky.", "sources": ["src:siva-samhita"], "rests_on": ["tea:siva-samhita:5.15-20"]}], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "native": "प्रतीक", "literal": "image; symbol", "related": [], "concepts": [], "coverage": ["E", "A10"]}
{"id": "trm:amrtikarana", "term": "amṛtīkaraṇa", "language": "Sanskrit", "definitions": [{"lineage": "lin:mantrasastra", "definition": "The rite of turning the offering-water into nectar, done with the dhenu gesture.", "sources": ["src:saradatilaka"], "rests_on": ["tea:saradatilaka:23.111-114"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "native": "अमृतीकरण", "literal": "making into nectar", "related": ["trm:mudra-ritual"], "concepts": [], "coverage": ["E", "A10"]}
{"id": "trm:sakalikarana", "term": "sakalīkaraṇa", "language": "Sanskrit", "definitions": [{"lineage": "lin:mantrasastra", "definition": "The placing of the six limbs (ṣaḍaṅga) on the deity's body, counted with the invocation gestures.", "sources": ["src:saradatilaka"], "rests_on": ["tea:saradatilaka:23.106-110"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "native": "सकलीकरण", "literal": "making (the deity) complete in parts", "related": ["trm:mudra-ritual"], "concepts": [], "coverage": ["E", "A10"]}
{"id": "trm:paramikarana", "term": "paramīkaraṇa", "language": "Sanskrit", "definitions": [{"lineage": "lin:mantrasastra", "definition": "The act done in worship with the hand-gesture called mahāmudrā (thumbs interlocked, fingers extended).", "sources": ["src:saradatilaka"], "rests_on": ["tea:saradatilaka:23.111-114"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "native": "परमीकरण", "literal": "making supreme", "related": ["trm:mudra-ritual"], "concepts": [], "coverage": ["E", "A10"]}
{"id": "trm:avagunthana", "term": "avaguṇṭhana", "language": "Sanskrit", "definitions": [{"lineage": "lin:mantrasastra", "definition": "The protective 'veiling' of the deity or offering, made with the right fist and extended index finger turned around.", "sources": ["src:saradatilaka"], "rests_on": ["tea:saradatilaka:23.111-114"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "native": "अवगुण्ठन", "literal": "veiling; enclosing", "related": ["trm:mudra-ritual"], "concepts": [], "coverage": ["E", "A10"]}
{"id": "trm:pitha", "term": "pīṭha", "language": "Sanskrit", "definitions": [{"lineage": "lin:hatha-yoga", "definition": "A seat, used in the haṭha texts as a synonym of āsana (posture): 'the eighty-four seats', 'Matsyendra's seat', 'the lord of yoga-seats'.", "sources": ["src:hatha-yoga-pradipika", "src:gheranda-samhita"], "rests_on": ["tea:hatha-yoga-pradipika:1.38-40", "tea:hatha-yoga-pradipika:1.67", "tea:gheranda-samhita:2.26"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:mudra-ritual", "term": "mudrā (ritual gesture)", "language": "Sanskrit", "definitions": [{"lineage": "lin:mantrasastra", "definition": "A gesture 'giving joy' (mudaṃ rāti) to the deity, made by joining the fingers, which are the five elements; the invocation series, dhenu, mahāmudrā and others are shown at fixed points of worship and are not to be shown to the uninitiated.", "sources": ["src:saradatilaka"], "rests_on": ["tea:saradatilaka:23.106-110", "tea:saradatilaka:23.114/comm"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
