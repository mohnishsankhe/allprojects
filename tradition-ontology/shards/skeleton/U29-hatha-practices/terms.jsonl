{"id": "trm:murccha", "term": "mūrcchā", "language": "Sanskrit", "definitions": [{"lineage": "lin:hatha-yoga", "definition": "The retention, with a very firm throat lock, that makes the mind faint (HYP 2.69); in the GS the 'swoon of the mind' with the attention between the brows (manomūrcchā).", "sources": ["src:hatha-yoga-pradipika", "src:gheranda-samhita"], "rests_on": ["tea:hatha-yoga-pradipika:2.69", "tea:gheranda-samhita:5.84-85"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "native": "मूर्च्छा", "literal": "swoon", "related": ["trm:kumbhaka", "trm:manomurccha"], "concepts": [], "coverage": ["E", "A10"]}
{"id": "trm:plavini", "term": "plāvinī", "language": "Sanskrit", "definitions": [{"lineage": "lin:hatha-yoga", "definition": "The retention in which the belly is filled with air so that one floats on water.", "sources": ["src:hatha-yoga-pradipika"], "rests_on": ["tea:hatha-yoga-pradipika:2.70"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "native": "प्लाविनी", "literal": "the floating", "related": ["trm:kumbhaka"], "concepts": [], "coverage": ["E", "A10"]}
{"id": "trm:sahita-kumbhaka", "term": "sahita (kumbhaka)", "language": "Sanskrit", "definitions": [{"lineage": "lin:hatha-yoga", "definition": "Retention joined with inhalation and exhalation, practised until kevala (retention alone) arises; in the GS the first of the eight retentions, of two kinds, sagarbha and nirgarbha.", "sources": ["src:hatha-yoga-pradipika", "src:gheranda-samhita", "src:dattatreyayogasastra"], "rests_on": ["tea:hatha-yoga-pradipika:2.71", "tea:hatha-yoga-pradipika:2.72-74", "tea:gheranda-samhita:5.47-48", "tea:dattatreyayogasastra:55-61"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "native": "सहित कुम्भक", "literal": "accompanied (retention)", "related": ["trm:kumbhaka", "trm:kevala-kumbhaka", "trm:sagarbha"], "concepts": [], "coverage": ["E", "A10"]}
{"id": "trm:sagarbha", "term": "sagarbha / nirgarbha", "language": "Sanskrit", "definitions": [{"lineage": "lin:hatha-yoga", "definition": "The two kinds of sahita retention in the GS: with the seed-syllables a, u, m and meditation on Brahmā, Viṣṇu and Rudra, or without seed.", "sources": ["src:gheranda-samhita"], "rests_on": ["tea:gheranda-samhita:5.47-48", "tea:gheranda-samhita:5.49-52"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "native": "सगर्भ / निर्गर्भ", "literal": "with / without seed (garbha)", "related": ["trm:sahita-kumbhaka"], "concepts": [], "coverage": ["E", "A10"], "equivalents": [{"target": "trm:sabija-pranayama", "grade": "partial", "note": "Both divide breath-control by the presence or absence of a support; the Viṣṇu Purāṇa's support is the Lord's form, the Gheraṇḍa's the seed-syllables with the three gods.", "rests_on": ["tea:gheranda-samhita:5.47-48", "tea:visnu-purana:6.7.36-45"]}]}
