{"id": "trm:visistadvaita", "term": "viśiṣṭādvaita", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The doctrine that Brahman, qualified by souls and matter as its inseparable modes, is one without a second; also read as the non-duality of Brahman in its causal (subtle) and effected (gross) states.", "sources": ["src:sribhasya", "src:vedarthasangraha"], "rests_on": ["tea:vedarthasangraha:ghataka-sruti", "tea:sribhasya:2.3/3"]}], "literal": "non-duality of the qualified", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "native": "विशिष्टाद्वैत", "concepts": ["cpt:qualified-non-dualism"], "coverage": ["A6", "D"]}
{"id": "trm:prakara", "term": "prakāra", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "A mode: an entity that exists only as the attribute of another (its prakārin) and cannot be known apart from it; souls and matter are modes of Brahman.", "sources": ["src:sribhasya", "src:vedarthasangraha"], "rests_on": ["tea:sribhasya:2.3/3"]}], "literal": "mode", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "native": "प्रकार", "concepts": ["cpt:qualified-non-dualism", "cpt:aprthak-siddhi"], "related": ["trm:visesana"], "coverage": ["A6", "D"]}
{"id": "trm:visesana", "term": "viśeṣaṇa", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "That which qualifies and distinguishes a substrate (viśeṣya); the soul is a qualifier of Brahman and so an 'aṃśa' of it.", "sources": ["src:sribhasya"], "rests_on": ["tea:sribhasya:2.3/3"]}], "literal": "qualifier, attribute", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:qualified-non-dualism"], "related": ["trm:prakara"], "coverage": ["A6", "D"]}
{"id": "trm:sarira", "term": "śarīra", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "Any substance that a conscious being wholly controls and supports for its own purposes and that exists for it alone (as its śeṣa); in this sense all souls and all matter are the body of the Lord, who is their self (śarīrin).", "sources": ["src:sribhasya", "src:vedarthasangraha"], "rests_on": ["tea:sribhasya:2.1.9", "tea:sribhasya:1.2", "tea:vedarthasangraha:ghataka-sruti"]}], "literal": "body", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:sarira-sariri-bhava"], "coverage": ["A6", "D"]}
{"id": "trm:aprthak-siddhi", "term": "apṛthak-siddhi", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The relation of inseparable existence between a substance and its mode (as between Brahman and souls/matter, or a substance and its attribute): the mode can neither exist nor be known apart from the substrate, yet is distinct from it.", "sources": ["src:sribhasya", "src:yatindramatadipika"], "rests_on": ["tea:sribhasya:2.3/3"]}], "literal": "inseparable establishment", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "native": "अपृथक्सिद्धि", "concepts": ["cpt:aprthak-siddhi"], "coverage": ["A6", "D"]}
{"id": "trm:samanadhikaranya", "term": "sāmānādhikaraṇya", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The application of several words, with different grounds of application, to one and the same object ('the blue lotus'); identity statements like 'tat tvam asi' name one Brahman under different modes, keeping the primary sense of each word.", "sources": ["src:vedarthasangraha", "src:sribhasya"], "rests_on": ["tea:vedarthasangraha:tat-tvam-asi"]}], "literal": "co-reference, having the same substrate", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "native": "सामानाधिकरण्य", "concepts": ["cpt:samanadhikaranya"], "coverage": ["A6", "D"]}
{"id": "trm:tattvatraya", "term": "tattvatraya", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The three real categories: cit (souls), acit (insentient matter) and Īśvara (the Lord).", "sources": ["src:tattvatraya", "src:yatindramatadipika"], "rests_on": ["tea:tattvatraya:1", "tea:tattvatraya:2", "tea:tattvatraya:3"]}], "literal": "the three realities", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:tattvatraya"], "related": ["trm:cit", "trm:acit", "trm:isvara"], "coverage": ["A6", "D"]}
{"id": "trm:cit", "term": "cit", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "Sentient reality: the individual souls, eternal, atomic knowers, bound, freed or eternally free; one of the three realities.", "sources": ["src:tattvatraya"], "rests_on": ["tea:tattvatraya:1"]}], "literal": "the sentient", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:tattvatraya", "cpt:jiva"], "related": ["trm:jiva"], "coverage": ["A6", "D"]}
{"id": "trm:acit", "term": "acit", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "Insentient reality in three kinds: pure sattva, mixed sattva (prakṛti) and that devoid of sattva (time); the body of the Lord together with the souls.", "sources": ["src:tattvatraya"], "rests_on": ["tea:tattvatraya:2"]}], "literal": "the insentient", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:three-kinds-of-acit", "cpt:tattvatraya"], "coverage": ["A6", "D"]}
{"id": "trm:isvara", "term": "Īśvara", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "Nārāyaṇa, the third reality: the self of all, cause of the world, opposed to all evil and abode of infinite auspicious qualities, present in five forms.", "sources": ["src:tattvatraya", "src:sribhasya"], "rests_on": ["tea:tattvatraya:3", "tea:sribhasya:3.2"]}], "literal": "the Lord", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:tattvatraya", "cpt:ubhaya-linga"], "coverage": ["A6", "D"]}
{"id": "trm:brahman", "term": "Brahman", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The supreme reality, Nārāyaṇa, great in essence and qualities and making others great; qualified (saviśeṣa) by souls and matter, never an attributeless consciousness.", "sources": ["src:sribhasya", "src:vedarthasangraha"], "rests_on": ["tea:sribhasya:1.1.1/5", "tea:sribhasya:1.1.2", "tea:sribhasya:3.2"]}], "literal": "the great", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:qualified-non-dualism"], "coverage": ["A6", "D"]}
{"id": "trm:jiva", "term": "jīva / jīvātman", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The individual self: eternal, atomic, a knower by nature and possessing attributive consciousness, agent and enjoyer dependent on the Lord, essentially his servant (śeṣa); countless in number.", "sources": ["src:sribhasya", "src:tattvatraya"], "rests_on": ["tea:sribhasya:2.3", "tea:sribhasya:2.3/2", "tea:tattvatraya:1"]}], "literal": "the living self", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:jiva"], "coverage": ["A6", "D"]}
{"id": "trm:dharmabhuta-jnana", "term": "dharmabhūta-jñāna", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "Attributive consciousness: the soul's (and the Lord's) consciousness as a quality distinct from the self-luminous substrate; eternal, it contracts in bondage through karma and expands fully in liberation; it goes out to objects as a lamp's light.", "sources": ["src:sribhasya", "src:yatindramatadipika", "src:tattvamuktakalapa"], "rests_on": ["tea:sribhasya:1.1.1/6", "tea:sribhasya:2.3", "tea:tattvamuktakalapa:2"]}], "literal": "knowledge that is an attribute", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:dharmabhuta-jnana"], "coverage": ["A6", "D"]}
{"id": "trm:aham-artha", "term": "aham-artha", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The self as what the word and awareness 'I' refer to; not the ego-evolute of prakṛti but the soul itself, which persists as 'I' in deep sleep and liberation.", "sources": ["src:sribhasya"], "rests_on": ["tea:sribhasya:1.1.1/6"]}], "literal": "the object/referent of 'I'", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:aham-artha"], "coverage": ["A6", "D"]}
{"id": "trm:anutva", "term": "aṇutva", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The soul's atomic size: it dwells in the heart and pervades the body by its attributive consciousness.", "sources": ["src:sribhasya"], "rests_on": ["tea:sribhasya:2.3"]}], "literal": "atomicity", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:jiva"], "coverage": ["A6", "D"]}
{"id": "trm:sesa", "term": "śeṣa", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "That whose nature is to exist for the purpose of another (the śeṣin) and to enhance him; every soul and thing is śeṣa of the Lord.", "sources": ["src:vedarthasangraha", "src:sribhasya", "src:rahasyatrayasara"], "rests_on": ["tea:vedarthasangraha:1", "tea:sribhasya:2.1.9"]}], "literal": "remainder; what exists for another", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:sesa-sesi-bhava"], "related": ["trm:sesatva", "trm:paratantrya"], "coverage": ["A6", "D"]}
{"id": "trm:sesatva", "term": "śeṣatva", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The soul's essential nature as belonging to and existing for the Lord; its fulfilment is service (kainkarya).", "sources": ["src:rahasyatrayasara", "src:mumuksuppadi"], "rests_on": ["tea:mumuksuppadi:1", "tea:sriranga-gadya:1"]}], "literal": "being-for-another, servitude", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:sesa-sesi-bhava"], "coverage": ["A6", "D"]}
{"id": "trm:ananyarha-sesatva", "term": "ananyārha-śeṣatva", "language": "Sanskrit", "definitions": [{"lineage": "lin:tenkalai", "definition": "The soul's being fit to belong to the Lord alone, not to itself nor to any other being; taught in the praṇava of the tirumantra.", "sources": ["src:mumuksuppadi"], "rests_on": ["tea:mumuksuppadi:1"]}], "literal": "servitude fit for no other", "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "concepts": ["cpt:sesa-sesi-bhava"], "coverage": ["A6", "D"]}
{"id": "trm:paratantrya", "term": "pāratantrya", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "Complete dependence on the Lord for existence, knowledge and action; the Teṅkalai hold it deeper than śeṣatva, excluding any independent act of one's own toward salvation.", "sources": ["src:sribhasya", "src:srivacana-bhusanam"], "rests_on": ["tea:sribhasya:2.3/2", "tea:srivacana-bhusanam:2"]}], "literal": "dependence", "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "concepts": ["cpt:sesa-sesi-bhava"], "coverage": ["A6", "D"]}
{"id": "trm:ubhaya-linga", "term": "ubhaya-liṅga", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The twofold character of Brahman in all scripture: opposition to all that is defiling and possession of infinite auspicious qualities.", "sources": ["src:sribhasya"], "rests_on": ["tea:sribhasya:3.2"]}], "literal": "twofold mark", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:ubhaya-linga"], "related": ["trm:heya-pratyanika", "trm:kalyana-guna"], "coverage": ["A6", "D"]}
{"id": "trm:heya-pratyanika", "term": "akhila-heya-pratyanīka", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "Brahman's freedom from, and opposition to, every defect: ignorance, karma, change, suffering.", "sources": ["src:sribhasya", "src:gita-bhasya-ramanuja"], "rests_on": ["tea:sribhasya:3.2", "tea:gita-bhasya-ramanuja:intro"]}], "literal": "opposed to all that is to be shunned", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:ubhaya-linga"], "coverage": ["A6", "D"]}
{"id": "trm:kalyana-guna", "term": "kalyāṇa-guṇa", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The Lord's infinite, unsurpassed auspicious qualities — knowledge, power, lordship, strength, virility, splendour and countless others such as compassion, accessibility and motherly love — not born of prakṛti.", "sources": ["src:sribhasya", "src:vedarthasangraha"], "rests_on": ["tea:vedarthasangraha:1", "tea:sribhasya:3.2"]}], "literal": "auspicious quality", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:kalyana-gunas"], "coverage": ["A6", "D"]}
{"id": "trm:para-vasudeva", "term": "para (Para-Vāsudeva)", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The Lord's highest form in Vaikuṇṭha, seated with Śrī, Bhū and Nīlā, served by the eternal and freed souls.", "sources": ["src:tattvatraya", "src:yatindramatadipika"], "rests_on": ["tea:tattvatraya:3", "tea:yatindramatadipika:9"]}], "literal": "the supreme form", "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "concepts": ["cpt:five-forms-of-god-pancaratra"], "coverage": ["A6", "D"]}
{"id": "trm:vyuha", "term": "vyūha", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The four emanations Vāsudeva, Saṅkarṣaṇa, Pradyumna and Aniruddha, each manifesting the six qualities or pairs of them, for creation, maintenance, dissolution and for the meditation of seekers.", "sources": ["src:tattvatraya", "src:yatindramatadipika"], "rests_on": ["tea:tattvatraya:3", "tea:yatindramatadipika:9"]}], "literal": "array, emanation", "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "concepts": ["cpt:five-forms-of-god-pancaratra"], "coverage": ["A6", "D"]}
{"id": "trm:vibhava", "term": "vibhava", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The Lord's descents (avatāra) — principal ones like Rāma and Kṛṣṇa in bodies of pure sattva taken by his will, and secondary ones by empowerment of souls — for the protection of the good.", "sources": ["src:tattvatraya", "src:yatindramatadipika"], "rests_on": ["tea:tattvatraya:3", "tea:yatindramatadipika:9"]}], "literal": "descent", "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "concepts": ["cpt:five-forms-of-god-pancaratra"], "coverage": ["A6", "D"]}
{"id": "trm:antaryamin", "term": "antaryāmin", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The Lord dwelling within every soul and thing as its self and controller, and, in a special form, in the heart of the meditator.", "sources": ["src:tattvatraya", "src:yatindramatadipika"], "rests_on": ["tea:tattvatraya:3", "tea:yatindramatadipika:9"]}], "literal": "inner controller", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:five-forms-of-god-pancaratra"], "coverage": ["A6", "D"]}
{"id": "trm:arca", "term": "arcā / arcāvatāra", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The Lord's descent into consecrated images in temples and homes, the most accessible of his forms, where he depends even on his worshippers.", "sources": ["src:tattvatraya", "src:yatindramatadipika"], "rests_on": ["tea:tattvatraya:3", "tea:yatindramatadipika:9"]}], "literal": "image-descent", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:five-forms-of-god-pancaratra"], "coverage": ["A6", "D"]}
{"id": "trm:nitya-vibhuti", "term": "nitya-vibhūti", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The Lord's eternal domain, Vaikuṇṭha or Paramapada, made of pure sattva, beyond prakṛti and time, where the eternal and freed souls serve him.", "sources": ["src:tattvatraya", "src:vaikuntha-gadya"], "rests_on": ["tea:vaikuntha-gadya:1", "tea:tattvatraya:2"]}], "literal": "the eternal realm", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:ubhaya-vibhuti"], "coverage": ["A6", "D"]}
{"id": "trm:lila-vibhuti", "term": "līlā-vibhūti", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The realm of prakṛti and time, where creation, maintenance and dissolution are the Lord's play and bound souls transmigrate.", "sources": ["src:tattvatraya", "src:sribhasya"], "rests_on": ["tea:sribhasya:mangala", "tea:tattvatraya:2"]}], "literal": "the realm of play", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:ubhaya-vibhuti"], "coverage": ["A6", "D"]}
{"id": "trm:suddha-sattva", "term": "śuddha-sattva", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "A self-luminous insentient substance free of rajas and tamas, of which Vaikuṇṭha and the divine forms of the Lord and the freed are made.", "sources": ["src:tattvatraya"], "rests_on": ["tea:tattvatraya:2"]}], "literal": "pure sattva", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:three-kinds-of-acit"], "coverage": ["A6", "D"]}
{"id": "trm:misra-sattva", "term": "miśra-sattva", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "Prakṛti, in which sattva is mixed with rajas and tamas; the material of bodies and worlds; it veils the soul's knowledge.", "sources": ["src:tattvatraya"], "rests_on": ["tea:tattvatraya:2"]}], "literal": "mixed sattva", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:three-kinds-of-acit", "cpt:prakrti"], "coverage": ["A6", "D"]}
{"id": "trm:sattva-sunya", "term": "sattva-śūnya", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "Time (kāla), the insentient reality lacking the guṇas, which measures change in the realm of prakṛti.", "sources": ["src:tattvatraya"], "rests_on": ["tea:tattvatraya:2"]}], "literal": "devoid of sattva", "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "concepts": ["cpt:three-kinds-of-acit", "cpt:kala"], "coverage": ["A6", "D"]}
{"id": "trm:kala", "term": "kāla", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "An eternal insentient substance without the guṇas, the Lord's body and instrument; in the eternal realm time exists but does not govern.", "sources": ["src:yatindramatadipika", "src:tattvatraya"], "rests_on": ["tea:tattvatraya:2", "tea:yatindramatadipika:dravya"]}], "literal": "time", "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "concepts": ["cpt:kala"], "coverage": ["A6", "D"]}
{"id": "trm:prakrti", "term": "prakṛti", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "Mixed-sattva matter with the three guṇas, eternal and real, the Lord's body, transforming into the twenty-three evolutes; it is also called māyā because it produces wonderful effects.", "sources": ["src:tattvatraya", "src:sribhasya"], "rests_on": ["tea:tattvatraya:2", "tea:sribhasya:1.4.23"]}], "literal": "primal matter", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:three-kinds-of-acit", "cpt:prakrti"], "coverage": ["A6", "D"]}
{"id": "trm:maya", "term": "māyā", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "Not an illusion-producing ignorance but prakṛti, called māyā because it produces manifold wonderful effects, and the Lord's wonderful power; the world it produces is real.", "sources": ["src:sribhasya"], "rests_on": ["tea:sribhasya:1.1.1/7", "tea:sribhasya:2.1.15"]}], "literal": "wonder-working power", "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "concepts": ["cpt:prakrti"], "coverage": ["A6", "D"]}
{"id": "trm:avidya", "term": "avidyā", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "Not an indescribable cosmic ignorance but karma (the third power 'avidyā-karma' of Viṣṇu Purāṇa 6.7.61) and the ignorance it causes in the soul — the contraction of its knowledge and the mistaking of body for self.", "sources": ["src:sribhasya"], "rests_on": ["tea:sribhasya:1.1.1/9", "tea:sribhasya:1.1.1/7"]}], "literal": "nescience", "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "concepts": ["cpt:avidya", "cpt:saptavidha-anupapatti"], "coverage": ["A6", "D"]}
{"id": "trm:saptavidha-anupapatti", "term": "saptavidha-anupapatti", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "Rāmānuja's seven objections to Advaita's avidyā: of locus (āśraya), concealment (tirodhāna), nature (svarūpa), indescribability (anirvacanīyatva), means of knowledge (pramāṇa), remover (nivartaka) and removal (nivṛtti).", "sources": ["src:sribhasya"], "rests_on": ["tea:sribhasya:1.1.1/7"]}], "literal": "sevenfold untenability", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:saptavidha-anupapatti"], "coverage": ["A6", "D"]}
{"id": "trm:satkhyati", "term": "satkhyāti / yathārthakhyāti", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The theory that every cognition, even erroneous, apprehends something real; error is incomplete apprehension, explained by the triplication of elements (silver-particles present in the shell).", "sources": ["src:sribhasya", "src:yatindramatadipika"], "rests_on": ["tea:sribhasya:1.1.1/8", "tea:yatindramatadipika:1-3"]}], "literal": "apprehension of the real", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:satkhyati"], "coverage": ["A6", "D"]}
{"id": "trm:pramana", "term": "pramāṇa", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "Three are accepted — perception, inference and scripture; all of them apprehend qualified objects, none an undifferentiated reality.", "sources": ["src:sribhasya", "src:yatindramatadipika", "src:nyayaparisuddhi"], "rests_on": ["tea:sribhasya:1.1.1/5", "tea:yatindramatadipika:1-3"]}], "literal": "means of valid knowledge", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:pramana"], "coverage": ["A6", "D"]}
{"id": "trm:ghataka-sruti", "term": "ghaṭaka-śruti", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "Scriptural texts (such as the Antaryāmi Brāhmaṇa and Subāla Upaniṣad) that teach the body–self relation and so reconcile the texts of difference and of non-difference.", "sources": ["src:vedarthasangraha"], "rests_on": ["tea:vedarthasangraha:ghataka-sruti"]}], "literal": "mediating scripture", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:three-kinds-of-sruti"], "coverage": ["A6", "D"]}
{"id": "trm:parinama", "term": "pariṇāma", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The real change of Brahman's body from subtle to gross in creation, Brahman as self remaining unchanged; opposed to Advaita's apparent transformation (vivarta).", "sources": ["src:sribhasya"], "rests_on": ["tea:sribhasya:1.4.23", "tea:sribhasya:2.1.15"]}], "literal": "real transformation", "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "concepts": ["cpt:brahma-parinama"], "coverage": ["A6", "D"]}
{"id": "trm:aikasastrya", "term": "aikaśāstrya", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The doctrine that the Pūrva Mīmāṃsā (on ritual) and the Uttara Mīmāṃsā (on Brahman), with the Saṅkarṣa-kāṇḍa, form one continuous science.", "sources": ["src:sribhasya", "src:sesvaramimamsa"], "rests_on": ["tea:sribhasya:1.1.1", "tea:sesvaramimamsa:1.1.1"]}], "literal": "unity of the science", "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "concepts": ["cpt:aikasastrya"], "coverage": ["A6", "D"]}
{"id": "trm:sriyahpati", "term": "Śriyaḥpati / Śrīman Nārāyaṇa", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The name of the supreme as never apart from Śrī (Lakṣmī); the Lord is known and approached as her consort.", "sources": ["src:gita-bhasya-ramanuja", "src:rahasyatrayasara"], "rests_on": ["tea:gita-bhasya-ramanuja:intro", "tea:rahasyatrayasara:paradevata-paramarthya"]}], "literal": "Lord of Śrī", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:sri-tattva"], "coverage": ["A6", "D"]}
{"id": "trm:narayana", "term": "Nārāyaṇa", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The proper name of the supreme Brahman: both the abode of all souls and things and the one who abides in them; Brahmā and Śiva are souls in his body.", "sources": ["src:vedarthasangraha", "src:rahasyatrayasara", "src:mumuksuppadi"], "rests_on": ["tea:vedarthasangraha:narayana-supreme", "tea:rahasyatrayasara:mula-mantra", "tea:mumuksuppadi:1"]}], "literal": "abode of the souls / in whom all abide", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "coverage": ["A6", "D"]}
{"id": "trm:purusottama", "term": "Puruṣottama", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The Lord as distinct from and higher than both the bound (kṣara) and the freed (akṣara) souls (Gītā 15.16–18).", "sources": ["src:gita-bhasya-ramanuja"], "rests_on": ["tea:gita-bhasya-ramanuja:15.16-18"]}], "literal": "the supreme person", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "coverage": ["A6", "D"]}
{"id": "trm:laksmi", "term": "Śrī / Lakṣmī", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The Lord's eternal consort, inseparable from him, mother of the world and mediator; her rank is disputed between the northern and southern schools.", "sources": ["src:rahasyatrayasara", "src:srivacana-bhusanam", "src:catuhsloki"], "rests_on": ["tea:catuhsloki:1", "tea:saranagati-gadya:1"]}, {"lineage": "lin:vadakalai", "definition": "All-pervading like Viṣṇu and of the Lord's rank; with him the means and the goal; the divine couple is the object of surrender.", "sources": ["src:rahasyatrayasara", "src:rahasyaraksa"], "rests_on": ["tea:rahasyatrayasara:paradevata-paramarthya", "tea:rahasyaraksa:catuhsloki"]}, {"lineage": "lin:tenkalai", "definition": "The mediator (puruṣakāra) who reconciles soul and Lord; not herself the means; commonly reported as atomic in essence and of the rank of souls, though ever inseparable from the Lord.", "sources": ["src:srivacana-bhusanam", "src:mumuksuppadi"], "rests_on": ["tea:srivacana-bhusanam:1", "tea:mumuksuppadi:2"]}], "literal": "prosperity, glory; the Goddess", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:sri-tattva"], "coverage": ["A6", "D"]}
{"id": "trm:bhagavan", "term": "Bhagavān", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The Lord as possessing the six qualities (knowledge, power, lordship, strength, virility, splendour) without limit.", "sources": ["src:sribhasya", "src:yatindramatadipika"], "rests_on": ["tea:yatindramatadipika:9"]}], "literal": "the one possessing the six excellences", "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "concepts": ["cpt:kalyana-gunas", "cpt:six-gunas-of-bhagavan"], "coverage": ["A6", "D"]}
{"id": "trm:baddha", "term": "baddha", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "Souls bound in saṃsāra by beginningless karma, their knowledge contracted.", "sources": ["src:tattvatraya"], "rests_on": ["tea:tattvatraya:1"]}], "literal": "bound", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:classes-of-souls"], "coverage": ["A6", "D"]}
{"id": "trm:mukta", "term": "mukta", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "Souls released from saṃsāra who have reached Vaikuṇṭha and serve the Lord eternally.", "sources": ["src:tattvatraya"], "rests_on": ["tea:tattvatraya:1"]}], "literal": "freed", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:classes-of-souls"], "coverage": ["A6", "D"]}
{"id": "trm:nityasuri", "term": "nitya / nityasūri", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "Souls never bound, such as Ananta (Śeṣa), Garuḍa and Viṣvaksena, eternally serving the Lord in Vaikuṇṭha.", "sources": ["src:tattvatraya", "src:vaikuntha-gadya"], "rests_on": ["tea:tattvatraya:1", "tea:vaikuntha-gadya:1"]}], "literal": "the eternal ones", "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "concepts": ["cpt:classes-of-souls"], "coverage": ["A6", "D"]}
{"id": "trm:mumuksu", "term": "mumukṣu", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "A bound soul seeking liberation — either the isolation of the self (kaivalya) or the Lord; the latter are bhaktas or prapannas.", "sources": ["src:yatindramatadipika", "src:mumuksuppadi"], "rests_on": ["tea:yatindramatadipika:8"]}], "literal": "one seeking release", "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "concepts": ["cpt:classes-of-souls"], "coverage": ["A6", "D"]}
{"id": "trm:kaivalya", "term": "kaivalya", "language": "Sanskrit", "definitions": [{"lineage": "lin:visistadvaita", "definition": "The enjoyment of one's own pure self apart from the Lord, sought by some seekers; a lesser goal than the Lord's service.", "sources": ["src:gita-bhasya-ramanuja", "src:arthapancaka-pillai-lokacarya"], "rests_on": ["tea:gita-bhasya-ramanuja:7.16-18", "tea:arthapancaka-pillai-lokacarya:1"]}, {"lineage": "lin:vadakalai", "definition": "Not permanent: those who attain it eventually go on to the Lord.", "sources": ["src:rahasyatrayasara"], "rests_on": []}, {"lineage": "lin:tenkalai", "definition": "A permanent state, in a region at the edge of the eternal realm, from which there is no return.", "sources": [], "rests_on": []}], "literal": "isolation", "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}, "concepts": ["cpt:kaivalya"], "coverage": ["A6", "D"]}
