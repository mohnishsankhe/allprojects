{"id": "obs:bhranti-darsana", "name": "Erroneous vision (bhrānti-darśana)", "category": "obstacle", "description": "False knowledge. One of the nine obstacles (1.30, YBh 1.30).", "lineages": ["lin:patanjala-yoga"], "sources": [{"source": "src:yoga-sutra", "ref": "1.30", "rests_on": ["tea:yoga-sutra:1.30"]}, {"source": "src:yoga-bhasya", "ref": "1.30", "rests_on": ["tea:yoga-bhasya:1.30"]}], "antidotes": ["prc:ekatattva-abhyasa", "prc:isvara-pranidhana"], "coverage": ["A5", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
