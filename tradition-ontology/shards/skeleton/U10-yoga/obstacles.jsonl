{"id": "obs:nine-antarayas", "name": "The nine obstacles (antarāya), distractions of mind", "category": "obstacle", "description": "Illness, dullness, doubt, carelessness, laziness, non-abstention, erroneous vision, failure to gain a stage and instability — distractions of the mind, called impurities, adversaries and obstacles of yoga (1.30, YBh 1.30).", "lineages": ["lin:patanjala-yoga"], "sources": [{"source": "src:yoga-sutra", "ref": "1.30", "rests_on": ["tea:yoga-sutra:1.30"]}, {"source": "src:yoga-bhasya", "ref": "1.30", "rests_on": ["tea:yoga-bhasya:1.30"]}], "members": ["obs:vyadhi", "obs:styana", "obs:samsaya", "obs:pramada", "obs:alasya", "obs:avirati", "obs:bhranti-darsana", "obs:alabdha-bhumikatva", "obs:anavasthitatva"], "antidotes": ["prc:isvara-pranidhana", "prc:pranava-japa", "prc:ekatattva-abhyasa", "practice and dispassion (YBh 1.31)"], "coverage": ["A5", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "obs:vyadhi", "name": "Illness (vyādhi)", "category": "obstacle", "description": "Imbalance of the bodily elements, fluids and organs. One of the nine obstacles (1.30, YBh 1.30).", "lineages": ["lin:patanjala-yoga"], "sources": [{"source": "src:yoga-sutra", "ref": "1.30", "rests_on": ["tea:yoga-sutra:1.30"]}, {"source": "src:yoga-bhasya", "ref": "1.30", "rests_on": ["tea:yoga-bhasya:1.30"]}], "antidotes": ["prc:ekatattva-abhyasa", "prc:isvara-pranidhana"], "coverage": ["A5", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "obs:styana", "name": "Dullness (styāna)", "category": "obstacle", "description": "The mind's unfitness for work. One of the nine obstacles (1.30, YBh 1.30).", "lineages": ["lin:patanjala-yoga"], "sources": [{"source": "src:yoga-sutra", "ref": "1.30", "rests_on": ["tea:yoga-sutra:1.30"]}, {"source": "src:yoga-bhasya", "ref": "1.30", "rests_on": ["tea:yoga-bhasya:1.30"]}], "antidotes": ["prc:ekatattva-abhyasa", "prc:isvara-pranidhana"], "coverage": ["A5", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "obs:samsaya", "name": "Doubt (saṃśaya)", "category": "obstacle", "description": "A cognition touching both alternatives: 'it may be so, it may not'. One of the nine obstacles (1.30, YBh 1.30).", "lineages": ["lin:patanjala-yoga"], "sources": [{"source": "src:yoga-sutra", "ref": "1.30", "rests_on": ["tea:yoga-sutra:1.30"]}, {"source": "src:yoga-bhasya", "ref": "1.30", "rests_on": ["tea:yoga-bhasya:1.30"]}], "antidotes": ["prc:ekatattva-abhyasa", "prc:isvara-pranidhana"], "coverage": ["A5", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "obs:pramada", "name": "Carelessness (pramāda)", "category": "obstacle", "description": "Not cultivating the means of samādhi; Vyāsa warns that carelessness, ever watching for an opening, revives the afflictions (YBh 3.51). One of the nine obstacles (1.30, YBh 1.30).", "lineages": ["lin:patanjala-yoga"], "sources": [{"source": "src:yoga-sutra", "ref": "1.30", "rests_on": ["tea:yoga-sutra:1.30"]}, {"source": "src:yoga-bhasya", "ref": "1.30", "rests_on": ["tea:yoga-bhasya:1.30"]}, {"source": "src:yoga-bhasya", "ref": "3.51", "rests_on": ["tea:yoga-bhasya:3.51"]}], "antidotes": ["prc:ekatattva-abhyasa", "prc:isvara-pranidhana"], "coverage": ["A5", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "obs:alasya", "name": "Laziness (ālasya)", "category": "obstacle", "description": "Inactivity from heaviness of body and mind. One of the nine obstacles (1.30, YBh 1.30).", "lineages": ["lin:patanjala-yoga"], "sources": [{"source": "src:yoga-sutra", "ref": "1.30", "rests_on": ["tea:yoga-sutra:1.30"]}, {"source": "src:yoga-bhasya", "ref": "1.30", "rests_on": ["tea:yoga-bhasya:1.30"]}], "antidotes": ["prc:ekatattva-abhyasa", "prc:isvara-pranidhana"], "coverage": ["A5", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
