{"id": "pth:sannyasa-six-renunciant-grades", "name": "The grades of renouncer", "lineage": "lin:sannyasa", "sources": [{"source": "src:naradaparivrajaka-upanisad"}], "stages": [{"order": 1, "name": "kuṭīcaka", "gloss": "hut-dweller", "description": "Keeps topknot, thread, staff; eats in one place; external worship; reaches the earthly worlds.", "ref": "Nāradaparivrājaka 5; Bhikṣuka", "band": "B1"}, {"order": 2, "name": "bahūdaka", "gloss": "of many waters", "description": "Triple staff; eight mouthfuls from many houses; reaches heaven.", "ref": "Nāradaparivrājaka 5; Bhikṣuka", "band": "B2"}, {"order": 3, "name": "haṃsa", "gloss": "swan", "description": "Matted hair; alms unplanned; mental worship; reaches the world of austerity.", "ref": "Nāradaparivrājaka 5; Bhikṣuka", "band": "B3"}, {"order": 4, "name": "paramahaṃsa", "gloss": "supreme swan", "description": "No topknot or thread; hand as bowl; reaches the world of truth; for him no dharma or adharma.", "ref": "Nāradaparivrājaka 5; Bhikṣuka", "band": "B6"}, {"order": 5, "name": "turīyātīta", "gloss": "beyond the fourth", "description": "Takes food like a cow; naked; body as corpse; kaivalya in the Self.", "ref": "Nāradaparivrājaka 5; Turīyātīta", "band": "B7"}, {"order": 6, "name": "avadhūta", "gloss": "who has shaken off", "description": "No rule; python's way; beyond castes and stages; acts as child, madman or ghost.", "ref": "Nāradaparivrājaka 5; Avadhūta; Jābāla 6", "band": "B8"}], "rests_on": ["tea:naradaparivrajaka-upanisad:5-six-kinds", "tea:naradaparivrajaka-upanisad:5-worlds", "tea:bhiksuka-upanisad:1-paramahamsa", "tea:turiyatita-upanisad:1-sequence", "tea:avadhuta-upanisad:2"], "coverage": ["A2", "F"], "verification": {"level": "skeleton", "confidence": "low", "unverified": false, "checks": []}}
{"id": "pth:sannyasa-rite-sequence", "name": "The sequence of the renunciation rite", "lineage": "lin:sannyasa", "sources": [{"source": "src:naradaparivrajaka-upanisad"}], "stages": [{"order": 1, "name": "vairāgya and eligibility", "gloss": "dispassion, qualification", "description": "Renounce the day dispassion arises; eligibility examined; consent of kin.", "ref": "Jābāla 4; Nāradaparivrājaka 3", "band": "B0"}, {"order": 2, "name": "kṛcchra", "gloss": "penances", "description": "Expiatory penances.", "ref": "Nāradaparivrājaka 4.38", "band": "B1"}, {"order": 3, "name": "aṣṭa-śrāddha", "gloss": "eight ancestor-rites", "description": "To gods, seers, divine beings, humans, elements, fathers, mothers and oneself — a ritual death.", "ref": "Nāradaparivrājaka 4.38", "band": "B0"}, {"order": 4, "name": "virajā-homa", "gloss": "purificatory oblation", "description": "Oblations that purify the elements of the body.", "ref": "Nāradaparivrājaka 4.38", "band": "B1"}, {"order": 5, "name": "agni-samāropa", "gloss": "fires placed in the self", "description": "The sacred fires taken into oneself; Sāvitrī into the vyāhṛtis.", "ref": "Āruṇi 2; Nāradaparivrājaka 4.38", "band": "B0"}, {"order": 6, "name": "praiṣa", "gloss": "declaration", "description": "'I have risen above the desires for wife, wealth and worlds'; 'I have renounced' thrice.", "ref": "Āruṇi 3; Nāradaparivrājaka 4.38", "band": "B0"}, {"order": 7, "name": "abhaya", "gloss": "fearlessness", "description": "'Fearlessness to all beings from me'.", "ref": "Āruṇi 3", "band": "B1"}, {"order": 8, "name": "liṅga-tyāga / liṅga-grahaṇa", "gloss": "marks abandoned or taken", "description": "Topknot and thread abandoned into water; staff, cloth, water-pot taken (or kept for life in the Vaiṣṇava rite).", "ref": "Jābāla 6; Nāradaparivrājaka 4.38; Śāṭyāyanīya 6-8", "band": "B0"}, {"order": 9, "name": "upadeśa", "gloss": "teaching", "description": "The guru gives praṇava and the great saying.", "ref": "Nāradaparivrājaka 4.38; Paramahaṃsaparivrājaka", "band": "B0"}], "rests_on": ["tea:jabala-upanisad:4-stages", "tea:aruni-upanisad:3", "tea:naradaparivrajaka-upanisad:4.38-rite", "tea:paramahamsaparivrajaka-upanisad:1-rite"], "coverage": ["A2", "F"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}}
{"id": "pth:muktika-path", "name": "Muktikā: the path to liberation", "lineage": "lin:upanisadic", "sources": [{"source": "src:muktika-upanisad"}], "stages": [{"order": 1, "name": "sādhana-catuṣṭaya", "gloss": "fourfold means", "description": "Discrimination, dispassion, six virtues, longing for liberation.", "ref": "1 prose", "band": "B0"}, {"order": 2, "name": "sadguru", "gloss": "approaching a true teacher", "description": "Approach with gifts; be tested.", "ref": "1 prose; 1.40-49", "band": "B0"}, {"order": 3, "name": "graded study", "gloss": "Māṇḍūkya → 10 → 32 → 108", "description": "Study as much as needed for knowledge to arise.", "ref": "1.26-29", "band": "B2"}, {"order": 4, "name": "śravaṇa", "gloss": "hearing", "description": "Hearing the Upaniṣads from the teacher.", "ref": "1 prose", "band": "B2"}, {"order": 5, "name": "manana", "gloss": "reflection", "description": "Reflecting on what is heard.", "ref": "1 prose", "band": "B3"}, {"order": 6, "name": "nididhyāsana", "gloss": "contemplation", "description": "Contemplation, with destruction of vāsanā and dissolution of mind.", "ref": "1 prose; 2.10-13", "band": "B4"}, {"order": 7, "name": "jīvanmukti", "gloss": "liberation while living", "description": "Mind dissolved 'with form'; prārabdha continues.", "ref": "1 prose; 2.32-35", "band": "B7"}, {"order": 8, "name": "videhamukti", "gloss": "bodiless liberation", "description": "At the body's fall, like pot-space or wind becoming still.", "ref": "2.76", "band": null}], "rests_on": ["tea:muktika-upanisad:1-prose-the-path", "tea:muktika-upanisad:1.26-29", "tea:muktika-upanisad:2.1-13", "tea:muktika-upanisad:2.76"], "coverage": ["A2", "F"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}}
