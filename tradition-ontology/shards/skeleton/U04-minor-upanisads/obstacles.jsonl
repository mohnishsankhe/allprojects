{"id": "obs:yogatattva-twenty-dosas", "name": "The twenty faults of the jīva (Yogatattva)", "category": "affliction", "description": "Twenty faults that bind the jīva; free of them it is called Śiva (Yogatattva 12–13; Yogaśikhā 1.10–11).", "lineages": ["lin:upanisadic"], "sources": [{"source": "src:yogatattva-upanisad", "ref": "12-13", "rests_on": ["tea:yogatattva-upanisad:12-13"]}], "members": ["kāma", "krodha", "bhaya", "moha", "lobha", "mada", "rajas", "janma", "mṛtyu", "kārpaṇya", "śoka", "tandrā", "kṣudhā", "tṛṣā", "tṛṣṇā", "lajjā", "saṃtrāsa", "duḥkha", "viṣāda", "harṣa"], "coverage": ["A2", "D"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}}
{"id": "obs:yogatattva-vighnas", "name": "Obstacles at the start of practice (Yogatattva)", "category": "obstacle", "description": "Sloth, boasting, the company of rogues, pursuit of mantras and the like, and craving for metals and women — mirages to be abandoned (Yogatattva 30–31).", "lineages": ["lin:upanisadic"], "sources": [{"source": "src:yogatattva-upanisad", "ref": "30-31", "rests_on": ["tea:yogatattva-upanisad:30-31"]}], "members": ["ālasya", "katthana", "dhūrta-goṣṭhī", "mantrādi-sādhana", "dhātu-strī-laulya"], "coverage": ["A2", "D"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}}
{"id": "obs:yogakundali-ten-vighnas", "name": "Ten obstacles (Yogakuṇḍalī)", "category": "obstacle", "description": "Disease, doubt, heedlessness, sloth, sleep, withdrawal of interest, delusion and further obstacles (readings uncertain), ending in failure to attain the truth of yoga; disease arises from wrong conduct such as day-sleep and excess.", "lineages": ["lin:upanisadic"], "sources": [{"source": "src:yogakundali-upanisad", "ref": "1.56-58", "rests_on": ["tea:yogakundali-upanisad:1.56-58"]}, {"source": "src:yogakundali-upanisad", "ref": "1.59-61", "rests_on": ["tea:yogakundali-upanisad:1.59-61"]}], "members": ["vyādhi", "saṃśaya", "pramattatā", "ālasya", "nidrā", "virati", "bhrānti", "(uncertain)", "(uncertain)", "alabdhi"], "antidotes": ["prc:mitahara"], "coverage": ["A2", "D"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}}
{"id": "obs:tejobindu-samadhi-vighnas", "name": "Obstacles in samādhi (Tejobindu)", "category": "meditation-fault", "description": "Lack of inquiry, sloth, desire for enjoyment, dissolution (laya), darkness, distraction, radiance, sweating and blankness (Tejobindu 1.40–41).", "lineages": ["lin:upanisadic"], "sources": [{"source": "src:tejobindu-upanisad", "ref": "1.40-41", "rests_on": ["tea:tejobindu-upanisad:1.40-41"]}], "members": ["anusandhāna-rāhitya", "ālasya", "bhoga-lālasa", "laya", "tamas", "vikṣepa", "tejas", "sveda", "śūnyatā"], "coverage": ["A2", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "obs:amrtanada-faults", "name": "Faults the yogin must avoid (Amṛtanāda)", "category": "obstacle", "description": "Fear, anger, sloth, too much sleep and waking, too much food and fasting (Amṛtanāda 27).", "lineages": ["lin:upanisadic"], "sources": [{"source": "src:amrtanada-upanisad", "ref": "27", "rests_on": ["tea:amrtanada-upanisad:27"]}], "members": ["bhaya", "krodha", "ālasya", "atisvapna", "atijāgara", "atyāhāra", "anāhāra"], "coverage": ["A2", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "obs:mandala-five-bodily-faults", "name": "Five faults of the body (Maṇḍalabrāhmaṇa)", "category": "dosa-imbalance", "description": "Desire, anger, disturbed breathing, fear and sleep; removed by freedom from willing, forbearance, light food, vigilance and devotion to truth (Maṇḍalabrāhmaṇa 1.2).", "lineages": ["lin:upanisadic"], "sources": [{"source": "src:mandalabrahmana-upanisad", "ref": "1.2 (five faults)", "rests_on": ["tea:mandalabrahmana-upanisad:1.2-five-faults"]}], "members": ["kāma", "krodha", "niḥśvāsa", "bhaya", "nidrā"], "coverage": ["A2", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "obs:three-vasanas", "name": "Three vāsanās (for the world, scripture and body)", "category": "bond", "description": "Vāsanās for social esteem, for scriptural learning and for the body, which prevent true knowledge (Muktikā 2).", "lineages": ["lin:upanisadic"], "sources": [{"source": "src:muktika-upanisad", "ref": "2.2", "rests_on": ["tea:muktika-upanisad:2.2"]}], "members": ["loka-vāsanā", "śāstra-vāsanā", "deha-vāsanā"], "coverage": ["A2", "D"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}}
{"id": "obs:three-esanas", "name": "Three desires (eṣaṇā)", "category": "passion", "description": "Desire for wife (sons), wealth and worlds, which the renouncer declares he has risen above (Nāradaparivrājaka 4.38; after Bṛhadāraṇyaka 3.5.1).", "lineages": ["lin:sannyasa", "lin:upanisadic"], "sources": [{"source": "src:naradaparivrajaka-upanisad", "ref": "4.38 (rite)", "rests_on": ["tea:naradaparivrajaka-upanisad:4.38-rite"]}], "members": ["dāraiṣaṇā / putraiṣaṇā", "vittaiṣaṇā", "lokaiṣaṇā"], "coverage": ["A2", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "obs:six-urmis", "name": "Six waves (ūrmi)", "category": "affliction", "description": "Hunger, thirst, grief, delusion, old age and death (Varāha 1; Vajrasūci).", "lineages": ["lin:upanisadic"], "sources": [{"source": "src:varaha-upanisad", "ref": "1.6-15", "rests_on": ["tea:varaha-upanisad:1.6-15"]}], "members": ["kṣudhā", "pipāsā", "śoka", "moha", "jarā", "mṛtyu"], "coverage": ["A2", "D"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}}
{"id": "obs:six-enemies", "name": "Six enemies (ṣaḍ-ripu)", "category": "passion", "description": "Desire, anger, greed, delusion, pride and envy (Varāha 1).", "lineages": ["lin:upanisadic"], "sources": [{"source": "src:varaha-upanisad", "ref": "1.6-15", "rests_on": ["tea:varaha-upanisad:1.6-15"]}], "members": ["kāma", "krodha", "lobha", "moha", "mada", "mātsarya"], "coverage": ["A2", "D"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}}
{"id": "obs:siddhis-as-obstacles", "name": "Powers as obstacles", "category": "obstacle", "description": "Powers arising from practice are obstacles to the great attainment; the yogin should hide them and not set his mind on them (Yogatattva 76–77; Varāha 3; Yogaśikhā 5.62).", "lineages": ["lin:upanisadic"], "sources": [{"source": "src:yogatattva-upanisad", "ref": "73-77", "rests_on": ["tea:yogatattva-upanisad:73-77"]}, {"source": "src:varaha-upanisad", "ref": "3.26-30", "rests_on": ["tea:varaha-upanisad:3.26-30"]}, {"source": "src:yogasikha-upanisad", "ref": "5.62", "rests_on": ["tea:yogasikha-upanisad:5.62"]}], "coverage": ["A2", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "obs:improper-pranayama", "name": "Improper breath-control", "category": "dosa-imbalance", "description": "Wrongly practised breath-control produces hiccup, asthma, cough and pains of head, ears and eyes, and can kill (Yogacūḍāmaṇi 116–118; Śāṇḍilya 1.23).", "lineages": ["lin:upanisadic"], "sources": [{"source": "src:yogacudamani-upanisad", "ref": "116-118", "rests_on": ["tea:yogacudamani-upanisad:116-118"]}, {"source": "src:sandilya-upanisad", "ref": "1.23", "rests_on": ["tea:sandilya-upanisad:1.23"]}], "antidotes": ["gradual practice under a guru"], "coverage": ["A2", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "obs:renouncer-causes-of-fall", "name": "What binds or makes a renouncer fall", "category": "bond", "description": "A fixed seat, loss of bowl, hoarding, gathering disciples for gain, sleep and idle talk (Sannyāsa 2.79–85); couch, white clothes, talk of women, day-sleep and vehicles (Nāradaparivrājaka 3.69–71).", "lineages": ["lin:sannyasa"], "sources": [{"source": "src:naradaparivrajaka-upanisad", "ref": "3.69-71", "rests_on": ["tea:naradaparivrajaka-upanisad:3.69-71"]}, {"source": "src:sannyasa-upanisad", "ref": "2.79-85", "rests_on": ["tea:sannyasa-upanisad:2.79-85"]}], "coverage": ["A2", "D"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}}
{"id": "obs:ascetic-hypocrisy", "name": "Renunciation without knowledge or for gain", "category": "other", "description": "Bearing the wooden staff without knowledge or renouncing for food or fame; such a renouncer 'falls from both worlds' (Paramahaṃsa; Maitreya 2.18–20; Nāradaparivrājaka 5).", "lineages": ["lin:sannyasa"], "sources": [{"source": "src:paramahamsa-upanisad", "ref": "1 (staff of knowledge)", "rests_on": ["tea:paramahamsa-upanisad:1-staff-of-knowledge"]}, {"source": "src:naradaparivrajaka-upanisad", "ref": "5 (other śāstras)", "rests_on": ["tea:naradaparivrajaka-upanisad:5-other-sastras"]}, {"source": "src:maitreya-upanisad", "ref": "2.18-20", "rests_on": ["tea:maitreya-upanisad:2.18-20"]}, {"source": "src:parabrahma-upanisad", "ref": "9", "rests_on": ["tea:parabrahma-upanisad:9"]}], "coverage": ["A2", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
