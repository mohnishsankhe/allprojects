{"id": "trm:buddhi", "term": "buddhi", "language": "Sanskrit", "literal": "intellect", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "Intellect: the inner organ as deciding; the seat of the reflected consciousness and of the ego's agency.", "sources": ["src:tattvabodha"]}], "concepts": ["cpt:antahkarana"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:citta", "term": "citta", "language": "Sanskrit", "literal": "mind-stuff", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "The inner organ as remembering and reflecting (in the fourfold Advaita division); in general usage, mind.", "sources": ["src:tattvabodha"]}], "concepts": ["cpt:antahkarana"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:ahankara", "term": "ahaṅkāra", "language": "Sanskrit", "literal": "I-maker", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "The ego, the I-maker: the inner organ as appropriating ('I', 'mine'), the knot of superimposition of consciousness and the insentient.", "sources": ["src:brahma-sutra-bhasya-sankara", "src:tattvabodha"], "rests_on": ["tea:brahma-sutra-bhasya-sankara:intro"]}], "concepts": ["cpt:antahkarana", "cpt:adhyasa"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:vrtti", "term": "vṛtti", "language": "Sanskrit", "literal": "mode, turning", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "A mode or modification of the inner organ; in perception it goes out and takes the form of the object; the mode in the form of Brahman removes ignorance.", "sources": ["src:vedantaparibhasa", "src:vedantasara"], "rests_on": ["tea:vedantaparibhasa:ch.1/2", "tea:vedantasara:akhandakara"]}], "concepts": ["cpt:perception-advaita"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:akhandakara-vrtti", "term": "akhaṇḍākāra-vṛtti", "language": "Sanskrit", "literal": "mode in the form of the undivided", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "The mental mode in the form of the partless Brahman arising from the mahāvākya; it destroys ignorance and then subsides, like a clearing-nut in water.", "sources": ["src:vedantasara"], "rests_on": ["tea:vedantasara:akhandakara"]}], "concepts": ["cpt:akhandakara-vrtti"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}}
{"id": "trm:vasana", "term": "vāsanā", "language": "Sanskrit", "literal": "scent, impression", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "Latent tendency: the impressions of past experience and action that incline the mind; the three vāsanās (world, scripture-learning, body) obstruct knowledge; their destruction is a discipline of the jīvanmukta.", "sources": ["src:vivekacudamani", "src:jivanmuktiviveka"], "rests_on": ["tea:vivekacudamani:270-272", "tea:jivanmuktiviveka:2-3"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:hrdaya-granthi", "term": "hṛdaya-granthi", "language": "Sanskrit", "literal": "knot of the heart", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "The knot of the heart: the ego-knot binding consciousness and the insentient, cut by knowledge (MU 2.2.8).", "sources": ["src:vivekacudamani"]}], "related": ["trm:ahankara"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}}
{"id": "trm:amanibhava", "term": "amanībhāva", "language": "Sanskrit", "literal": "becoming mind-less", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "The state of no-mind: when, through knowing the truth of the self, the mind ceases to imagine, grasping nothing (GK 3.32).", "sources": ["src:mandukya-karika"], "rests_on": ["tea:mandukya-karika:3.32"]}], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}}
