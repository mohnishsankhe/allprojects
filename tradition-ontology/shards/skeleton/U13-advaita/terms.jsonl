{"id": "trm:ananda", "term": "ānanda", "language": "Sanskrit", "literal": "bliss", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "Bliss: the nature of Brahman, not a quality it has; worldly joys are fragments of it, manifest in deep sleep as unobstructed bliss.", "sources": ["src:pancadasi"], "rests_on": ["tea:pancadasi:15"]}], "related": ["trm:saccidananda"], "concepts": ["cpt:bliss-advaita"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:saccidananda", "term": "saccidānanda", "language": "Sanskrit", "literal": "being-consciousness-bliss", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "Being–consciousness–bliss: the three words indicate, by excluding their opposites, the one attributeless Brahman; they are not three attributes.", "sources": ["src:vedantaparibhasa"], "rests_on": ["tea:vedantaparibhasa:ch.7", "tea:drg-drsya-viveka:20"]}], "concepts": ["cpt:sat-cit-ananda"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:nirguna", "term": "nirguṇa", "language": "Sanskrit", "literal": "without qualities", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "Without attributes: Brahman in itself, free of all qualities, relations and distinctions (BS 3.2.11, 3.2.14 as read by Śaṅkara).", "sources": ["src:brahma-sutra-bhasya-sankara"], "rests_on": ["tea:brahma-sutra:3.2.11", "tea:brahma-sutra:3.2.14"]}], "related": ["trm:saguna"], "concepts": ["cpt:nirguna-saguna-brahman"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:saguna", "term": "saguṇa", "language": "Sanskrit", "literal": "with qualities", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "With attributes: Brahman as associated with māyā — Īśvara, omniscient and omnipotent, object of worship and meditation; real at the empirical level.", "sources": ["src:brahma-sutra-bhasya-sankara"], "rests_on": ["tea:brahma-sutra-bhasya-sankara:2.1.14", "tea:brahma-sutra:3.2.15"]}], "related": ["trm:nirguna", "trm:isvara"], "concepts": ["cpt:nirguna-saguna-brahman"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:isvara", "term": "īśvara", "language": "Sanskrit", "native": "ईश्वर", "literal": "lord", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "The Lord: Brahman associated with māyā (or reflected in it), omniscient ruler, creator, sustainer and dissolver, giver of the fruits of action; his lordship depends on adjuncts of name and form.", "sources": ["src:brahma-sutra-bhasya-sankara", "src:pancadasi"], "rests_on": ["tea:brahma-sutra-bhasya-sankara:2.1.14", "tea:pancadasi:1.15-17", "tea:brahma-sutra:3.2.38"]}, {"lineage": "lin:vivarana", "definition": "The prototype (bimba) consciousness, of which the jīva is the reflection.", "sources": ["src:pancapadika-vivarana"], "rests_on": ["tea:pancapadika-vivarana:reflection"]}], "related": ["trm:saguna", "trm:maya", "trm:jiva"], "concepts": ["cpt:isvara-advaita"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:jiva", "term": "jīva", "language": "Sanskrit", "native": "जीव", "literal": "living being", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "The individual self: Brahman appearing as limited, reflected or semblanced through the adjunct of the inner organ (and ignorance); agent, enjoyer and transmigrant only through adjuncts; in truth Brahman.", "sources": ["src:brahma-sutra-bhasya-sankara"], "rests_on": ["tea:brahma-sutra-bhasya-sankara:1.4.22", "tea:brahma-sutra-bhasya-sankara:2.3.50"]}, {"lineage": "lin:vivarana", "definition": "The reflection of Brahman in avidyā/the inner organ, real and identical with the prototype.", "sources": ["src:pancapadika-vivarana"], "rests_on": ["tea:pancapadika-vivarana:reflection"]}, {"lineage": "lin:bhamati", "definition": "Brahman delimited by the inner organ; the locus of ignorance.", "sources": ["src:bhamati"], "rests_on": ["tea:bhamati:avaccheda", "tea:bhamati:locus"]}], "related": ["trm:atman", "trm:isvara", "trm:upadhi"], "concepts": ["cpt:jiva-advaita"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:saksin", "term": "sākṣin", "language": "Sanskrit", "native": "साक्षिन्", "literal": "eye-witness", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "The witness: consciousness that illumines the mind and its modes, the three states and their absence, itself unchanging and never an object.", "sources": ["src:drg-drsya-viveka", "src:pancadasi"], "rests_on": ["tea:drg-drsya-viveka:1", "tea:pancadasi:10"]}], "related": ["trm:kutastha", "trm:turiya"], "concepts": ["cpt:saksin"], "equivalents": [{"target": "trm:turiya", "grade": "partial", "standpoint": "", "note": "The witness of the three states is what the Māṇḍūkya calls the fourth; 'witness' names it in relation to what it witnesses, 'fourth' relative to the three states.", "rests_on": ["tea:mandukya-karika:1.10", "tea:pancadasi:1.3"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:kutastha", "term": "kūṭastha", "language": "Sanskrit", "literal": "standing like an anvil; immutable", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "The immutable, 'anvil-like' consciousness underlying the body and mind, distinct from the reflected consciousness (cidābhāsa); another name for the witness.", "sources": ["src:pancadasi"], "rests_on": ["tea:pancadasi:8", "tea:pancadasi:6/2"]}], "related": ["trm:saksin", "trm:cidabhasa"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}}
{"id": "trm:cidabhasa", "term": "cidābhāsa", "language": "Sanskrit", "literal": "semblance of consciousness", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "The semblance or reflection of consciousness in the intellect, which makes the inner organ appear conscious; together with the kūṭastha it constitutes the jīva.", "sources": ["src:pancadasi", "src:brhadaranyaka-bhasya-varttika"], "rests_on": ["tea:pancadasi:8", "tea:brhadaranyaka-bhasya-varttika:abhasa"]}], "related": ["trm:abhasa", "trm:pratibimba"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}}
{"id": "trm:turiya", "term": "turīya", "language": "Sanskrit", "native": "तुरीय", "literal": "the fourth", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "The fourth: not a fourth state beside waking, dream and sleep but the self that pervades and transcends them, non-dual, peaceful, auspicious; the Lord able to end all sorrow (GK 1.10).", "sources": ["src:mandukya-karika"], "rests_on": ["tea:mandukya-karika:1.10", "tea:mandukya-karika:1.11"]}], "concepts": ["cpt:three-states-and-turiya"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:svaprakasa", "term": "svaprakāśa", "language": "Sanskrit", "literal": "self-shining", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "Self-luminous: not requiring another cognition to be revealed; defined by Citsukha as being fit to be called immediate while not being an object of cognition.", "sources": ["src:tattvapradipika-citsukha"], "rests_on": ["tea:tattvapradipika-citsukha:1"]}], "concepts": ["cpt:svaprakasa"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}}
{"id": "trm:anubhuti", "term": "anubhūti", "language": "Sanskrit", "literal": "experience", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "Experience/awareness itself, the self as pure self-established consciousness (Iṣṭasiddhi).", "sources": ["src:istasiddhi"], "rests_on": ["tea:istasiddhi:1"]}], "verification": {"level": "skeleton", "confidence": "low", "unverified": false, "checks": []}}
{"id": "trm:maya", "term": "māyā", "language": "Sanskrit", "native": "माया", "literal": "magic power; illusion", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "The Lord's beginningless, indescribable power, consisting of the three guṇas, known from its effects, by which the one Brahman appears as the world; neither real nor unreal (VC 108–109).", "sources": ["src:vivekacudamani", "src:mandukya-karika"], "rests_on": ["tea:vivekacudamani:108", "tea:vivekacudamani:109", "tea:mandukya-karika:1.17"]}, {"lineage": "lin:advaita-vedanta", "definition": "In Vidyāraṇya's usage, prakṛti with pure sattva, the adjunct of Īśvara, as distinct from avidyā with impure sattva, the adjunct of the jīva.", "sources": ["src:pancadasi"], "rests_on": ["tea:pancadasi:1.15-17"]}], "related": ["trm:avidya", "trm:ajnana", "trm:anirvacaniya"], "concepts": ["cpt:maya"], "equivalents": [{"target": "trm:avidya", "grade": "contested", "standpoint": "", "note": "Identical in the Vivaraṇa and Saṃkṣepaśārīraka usage (one entity under two aspects); distinguished by Vidyāraṇya (pure vs impure sattva).", "rests_on": ["tea:pancadasi:1.15-17", "tea:vivekacudamani:108"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:avidya", "term": "avidyā", "language": "Sanskrit", "native": "अविद्या", "literal": "not-knowing", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "Ignorance: in Śaṅkara, superimposition itself (the non-discrimination of self and not-self); in later Advaita, a beginningless, positive, indescribable power that veils Brahman and projects the world, removed by knowledge alone.", "sources": ["src:brahma-sutra-bhasya-sankara", "src:vedantasara"], "rests_on": ["tea:brahma-sutra-bhasya-sankara:intro/3", "tea:vedantasara:ajnana"]}, {"lineage": "lin:vivarana", "definition": "One positive ignorance having pure consciousness as its locus and object.", "sources": ["src:pancapadika-vivarana"], "rests_on": ["tea:pancapadika-vivarana:locus", "tea:pancapadika-vivarana:bhava"]}, {"lineage": "lin:bhamati", "definition": "Ignorance residing in the individual selves (many, one per jīva), with Brahman as its object.", "sources": ["src:bhamati"], "rests_on": ["tea:bhamati:locus"]}], "related": ["trm:ajnana", "trm:maya", "trm:adhyasa", "trm:bhavarupa-avidya"], "concepts": ["cpt:avidya"], "equivalents": [{"target": "trm:ajnana", "grade": "exact", "standpoint": "", "note": "Used interchangeably in Advaita texts (Vedāntasāra prefers ajñāna).", "rests_on": ["tea:vedantasara:ajnana"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:ajnana", "term": "ajñāna", "language": "Sanskrit", "literal": "non-knowledge", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "Ignorance, synonym of avidyā: 'something positive, indescribable as being or non-being, made of the three guṇas, opposed to knowledge' (Vedāntasāra).", "sources": ["src:vedantasara"], "rests_on": ["tea:vedantasara:ajnana"]}], "related": ["trm:avidya"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:bhavarupa-avidya", "term": "bhāvarūpa-avidyā", "language": "Sanskrit", "literal": "ignorance of positive nature", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "Ignorance as a positive entity (not a mere absence of knowledge), held by the Vivaraṇa line and later Advaita, proved by the experience 'I am ignorant'; rejected as un-Śaṅkaran by Satchidanandendra (recent).", "sources": ["src:pancapadika-vivarana", "src:advaitasiddhi"], "rests_on": ["tea:pancapadika-vivarana:bhava", "tea:advaitasiddhi:1/2"]}], "concepts": ["cpt:bhavarupa-avidya"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}}
{"id": "trm:mula-avidya", "term": "mūlāvidyā", "language": "Sanskrit", "literal": "root ignorance", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "Root-ignorance: the beginningless causal ignorance that is the material cause of the world-appearance, as distinct from the particular ignorances (tūlāvidyā) of objects.", "sources": ["src:vedantaparibhasa"]}], "related": ["trm:avidya"], "verification": {"level": "skeleton", "confidence": "low", "unverified": false, "checks": []}}
{"id": "trm:avarana-sakti", "term": "āvaraṇa-śakti", "language": "Sanskrit", "literal": "veiling power", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "The veiling power of ignorance, which hides the self as a small cloud hides the sun from the viewer.", "sources": ["src:vedantasara", "src:drg-drsya-viveka"], "rests_on": ["tea:vedantasara:ajnana"]}], "concepts": ["cpt:avarana-viksepa"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:viksepa-sakti", "term": "vikṣepa-śakti", "language": "Sanskrit", "literal": "projecting power", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "The projecting power of ignorance, which projects the world and the subtle and gross bodies on the self, as ignorance of the rope projects the snake.", "sources": ["src:vedantasara"], "rests_on": ["tea:vedantasara:ajnana"]}], "concepts": ["cpt:avarana-viksepa"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:adhyasa", "term": "adhyāsa", "language": "Sanskrit", "native": "अध्यास", "literal": "placing upon", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "Superimposition: 'the appearance, of the nature of memory, of something previously seen in something else' — the mutual superimposition of self and not-self that is the basis of all empirical life, called avidyā.", "sources": ["src:brahma-sutra-bhasya-sankara"], "rests_on": ["tea:brahma-sutra-bhasya-sankara:intro/2", "tea:brahma-sutra-bhasya-sankara:intro/3"]}], "related": ["trm:avidya", "trm:adhyaropa"], "concepts": ["cpt:adhyasa"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:adhisthana", "term": "adhiṣṭhāna", "language": "Sanskrit", "literal": "ground, basis", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "Substratum: the real on which something unreal is superimposed (the rope for the snake; Brahman for the world).", "sources": ["src:atma-bodha"], "rests_on": ["tea:atma-bodha:7", "tea:mandukya-karika:2.17"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:vivarta", "term": "vivarta", "language": "Sanskrit", "native": "विवर्त", "literal": "turning aside; apparent change", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "Apparent transformation: a change in appearance without change in the substance, as the rope appears as a snake; the world is Brahman's vivarta and avidyā's pariṇāma.", "sources": ["src:bhamati", "src:vedantasara"], "rests_on": ["tea:bhamati:mangala", "tea:brahma-sutra:2.1.14"]}], "related": ["trm:parinama"], "concepts": ["cpt:vivarta-vada"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:parinama", "term": "pariṇāma", "language": "Sanskrit", "literal": "transformation", "definitions": [{"lineage": "lin:vedanta", "definition": "Transformation of a cause into an effect (BS 1.4.27).", "sources": ["src:brahma-sutra"], "rests_on": ["tea:brahma-sutra:1.4.27"]}, {"lineage": "lin:advaita-vedanta", "definition": "Real transformation (as milk into curd); Advaita accepts it only for māyā/avidyā in relation to the world, never for Brahman, which undergoes only apparent transformation (vivarta).", "sources": ["src:vedantaparibhasa"]}], "related": ["trm:vivarta"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:anirvacaniya", "term": "anirvacanīya", "language": "Sanskrit", "literal": "not to be spoken of", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "Indescribable: not determinable as real (since sublated) nor as unreal (since it appears); the status of māyā, avidyā and their products.", "sources": ["src:vivekacudamani", "src:pancapadika"], "rests_on": ["tea:vivekacudamani:109", "tea:pancapadika:1"]}], "related": ["trm:mithya"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:mithya", "term": "mithyā", "language": "Sanskrit", "literal": "false, wrongly", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "False: what appears but is sublated by knowledge; defined as indescribable, as the counterpositive of absence in its own locus in all three times, as removable by knowledge, or as other than the real (five definitions in the Advaitasiddhi).", "sources": ["src:advaitasiddhi"], "rests_on": ["tea:advaitasiddhi:1", "tea:brahmajnanavalimala:20"]}], "concepts": ["cpt:mithyatva"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:badha", "term": "bādha", "language": "Sanskrit", "literal": "cancellation", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "Sublation: the cancellation of a cognition by a later one that shows its object never was as it appeared (the snake by the rope-cognition); the criterion of the three levels of reality.", "sources": ["src:vedantaparibhasa"], "rests_on": ["tea:mandukya-karika:2.18"]}], "concepts": ["cpt:badha"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}}
{"id": "trm:paramarthika", "term": "pāramārthika", "language": "Sanskrit", "literal": "pertaining to the highest truth", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "Ultimately real: never sublated — Brahman alone.", "sources": ["src:mandukya-karika"], "rests_on": ["tea:mandukya-karika:1.17", "tea:mandukya-karika:2.32"]}], "concepts": ["cpt:three-levels-of-reality"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:vyavaharika", "term": "vyāvahārika", "language": "Sanskrit", "literal": "pertaining to transaction", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "Empirically real: valid for all practical dealings and sublated only by knowledge of Brahman — the waking world, Īśvara, scripture and the path.", "sources": ["src:brahma-sutra-bhasya-sankara"], "rests_on": ["tea:brahma-sutra-bhasya-sankara:2.1.14", "tea:brahma-sutra-bhasya-sankara:intro/4"]}], "concepts": ["cpt:three-levels-of-reality"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:pratibhasika", "term": "prātibhāsika", "language": "Sanskrit", "literal": "pertaining to mere appearance", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "Apparently real: existing only while perceived and sublated by ordinary waking cognition — dream objects, the rope-snake, shell-silver.", "sources": ["src:drg-drsya-viveka"], "rests_on": ["tea:drg-drsya-viveka:32-37"]}], "concepts": ["cpt:three-levels-of-reality"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
