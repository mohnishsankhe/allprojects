{"id": "trm:bimba", "term": "bimba", "language": "Sanskrit", "literal": "original disc; prototype", "definitions": [{"lineage": "lin:vivarana", "definition": "The prototype or original of a reflection; in the Vivaraṇa, Īśvara/Brahman as the original of which the jīva is the reflection.", "sources": ["src:pancapadika-vivarana"], "rests_on": ["tea:pancapadika-vivarana:reflection"]}], "concepts": ["cpt:pratibimba-vada"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}}
