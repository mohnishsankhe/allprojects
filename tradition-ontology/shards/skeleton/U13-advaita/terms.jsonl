{"id": "trm:jagrat", "term": "jāgrat", "language": "Sanskrit", "literal": "waking", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "Waking: the state in which the self, as viśva, experiences gross objects through the senses; empirically real.", "sources": ["src:mandukya-karika"], "rests_on": ["tea:mandukya-karika:1.11"]}], "concepts": ["cpt:three-states-and-turiya"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
