{"id": "trm:vacarambhana", "term": "vācārambhaṇa", "language": "Sanskrit", "literal": "origination in speech", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "'A matter of speech': the Chāndogya's description of modifications as mere names (the clay alone being real), the basis of the non-difference of effect from cause (BS 2.1.14).", "sources": ["src:brahma-sutra"], "rests_on": ["tea:brahma-sutra:2.1.14"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
