{"id": "trm:brahman", "term": "brahman", "language": "Sanskrit", "native": "ब्रह्मन्", "literal": "the vast; that which grows", "definitions": [{"lineage": "lin:vedanta", "definition": "That from which the origin, sustenance and dissolution of the world proceed, known from the Upaniṣads (BS 1.1.2–4).", "sources": ["src:brahma-sutra"], "rests_on": ["tea:brahma-sutra:1.1.2"]}, {"lineage": "lin:advaita-vedanta", "definition": "The one reality without a second: existence–consciousness–bliss, attributeless (nirguṇa) in itself, identical with the inner self; associated with māyā it is Īśvara, the world-cause.", "sources": ["src:brahma-sutra-bhasya-sankara", "src:vedantaparibhasa"], "rests_on": ["tea:taittiriya-upanisad-bhasya-sankara:2.1.1", "tea:vedantaparibhasa:ch.7"]}], "related": ["trm:atman", "trm:saccidananda", "trm:nirguna", "trm:saguna", "trm:isvara"], "concepts": ["cpt:brahman"], "equivalents": [{"target": "trm:atman", "grade": "same-under-standpoint", "standpoint": "pāramārthika (Advaita)", "note": "Advaita holds Brahman and the inner self identical; other Vedānta schools deny strict identity.", "rests_on": ["tea:brahmajnanavalimala:20", "tea:brahma-sutra-bhasya-sankara:1.4.22"]}], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:atman", "term": "ātman", "language": "Sanskrit", "native": "आत्मन्", "literal": "self", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "The inner self (pratyag-ātman): pure, self-luminous consciousness, the witness of the three states, not the body, senses, mind or ego; identical with Brahman.", "sources": ["src:brahma-sutra-bhasya-sankara", "src:upadesa-sahasri"], "rests_on": ["tea:brahma-sutra-bhasya-sankara:1.1.1/2", "tea:nirvana-satkam:1"]}], "related": ["trm:brahman", "trm:jiva", "trm:saksin"], "concepts": ["cpt:atman-brahman-identity"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:paramatman", "term": "paramātman", "language": "Sanskrit", "literal": "supreme self", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "The supreme self, i.e. Brahman as the self of all; not different from the inner self."}], "related": ["trm:atman", "trm:brahman"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "trm:sat", "term": "sat", "language": "Sanskrit", "literal": "being, the real", "definitions": [{"lineage": "lin:advaita-vedanta", "definition": "Existence/being: that which is never sublated in the three times; Brahman as pure being, present in every cognition 'it is'.", "sources": ["src:drg-drsya-viveka"], "rests_on": ["tea:drg-drsya-viveka:20"]}], "related": ["trm:saccidananda", "trm:mithya"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
