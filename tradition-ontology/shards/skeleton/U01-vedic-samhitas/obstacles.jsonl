{"id": "obs:anrta", "name": "Untruth (anṛta)", "category": "other", "description": "Untruth and breach of ṛta, which Varuṇa punishes with his fetters and from which the vow-taker turns to truth.", "lineages": ["lin:vedic-srauta"], "sources": [{"source": "src:atharvaveda-saunaka", "ref": "4.16.6", "rests_on": ["tea:atharvaveda-saunaka:4.16.2-6"]}], "equivalents": [], "antidotes": ["satya (truth)", "prc:diksa-soma"], "coverage": ["A1", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "notes": "rests_on: tea:atharvaveda-saunaka:4.16.2-6, tea:vajasaneyi-samhita:1.5, tea:rgveda:7.86.6"}
{"id": "obs:varuna-pasa", "name": "The fetters of Varuṇa (pāśa)", "category": "bond", "description": "The upper, middle and lower fetters with which Varuṇa binds the offender; loosened by his grace so that one becomes sinless before Aditi.", "lineages": ["lin:vedic-srauta"], "sources": [{"source": "src:rgveda", "ref": "1.24.15", "rests_on": ["tea:rgveda:1.24.15"]}], "equivalents": [], "antidotes": ["confession and supplication to Varuṇa", "truthfulness"], "coverage": ["A1", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "notes": "rests_on: tea:rgveda:1.24.15, tea:rgveda:7.88.7, tea:atharvaveda-saunaka:4.16.2-6"}
{"id": "obs:enas", "name": "Sin and offence (enas, āgas)", "category": "impurity", "description": "Faults against the gods' ordinances and against fellow men — one's own, bodily, inherited from the fathers, known and unknown — that must be loosened.", "lineages": ["lin:vedic-srauta"], "sources": [{"source": "src:rgveda", "ref": "7.86", "rests_on": ["tea:rgveda:7.86.2-4", "tea:rgveda:7.86.5"]}], "equivalents": [], "antidotes": ["prc:aghamarsana", "supplication to Varuṇa", "prāyaścitta"], "members": ["āgas", "enas", "duritam", "kilbiṣa (as usually listed)"], "coverage": ["A1", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}, "notes": "rests_on: tea:rgveda:7.86.5, tea:rgveda:7.89.5, tea:rgveda:5.85.7-8, tea:rgveda:2.28.5"}
