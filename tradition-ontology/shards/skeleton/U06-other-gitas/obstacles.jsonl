{"id": "obs:asa", "name": "Hope, expectation (āśā)", "category": "passion", "lineages": ["lin:puranic", "lin:epic-teaching"], "description": "Expectation of gain from others or the world, called the greatest misery; its absence (nairāśya) the greatest happiness.", "sources": [{"source": "src:uddhava-gita", "ref": "11.8.22-44", "rests_on": ["tea:uddhava-gita:11.8.22-44"]}, {"source": "src:pingala-gita", "ref": "12.168.52", "rests_on": ["tea:pingala-gita:12.168.52"]}, {"source": "src:rsabha-gita", "ref": "12.125-128", "rests_on": ["tea:rsabha-gita:12.125-128"]}], "antidotes": ["nirveda (disgust)", "refuge in the Lord", "contentment with what comes"], "members": [], "equivalents": [], "coverage": ["A3", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "obs:parigraha", "name": "Possessiveness (parigraha)", "category": "bond", "lineages": ["lin:puranic", "lin:epic-teaching"], "description": "Grasping at possessions and hoarding, which brings suffering and attack (the osprey, the bee, the honey-gatherer).", "sources": [{"source": "src:uddhava-gita", "ref": "11.9.1-2; 11.8.9-16", "rests_on": ["tea:uddhava-gita:11.9.1-2", "tea:uddhava-gita:11.8.9-12", "tea:uddhava-gita:11.8.15-16"]}, {"source": "src:samyaka-gita", "ref": "12.170", "rests_on": ["tea:samyaka-gita:12.170"]}], "antidotes": ["prc:madhukari-bhiksa", "owning nothing"], "members": [], "equivalents": [], "coverage": ["A3", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "obs:atisneha", "name": "Excessive attachment (atisneha)", "category": "bond", "lineages": ["lin:puranic"], "description": "Excessive affection for family and home, by which the householder perishes like the pigeon.", "sources": [{"source": "src:uddhava-gita", "ref": "11.7.52-74", "rests_on": ["tea:uddhava-gita:11.7.52-74"]}], "antidotes": ["dispassion", "seeing all as the Lord's"], "members": [], "equivalents": [], "coverage": ["A3", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "obs:rasa-lolupata", "name": "Craving of the tongue", "category": "passion", "lineages": ["lin:puranic"], "description": "Greed for taste, the sense that grows stronger with fasting and is conquered last; when taste is conquered all is conquered.", "sources": [{"source": "src:uddhava-gita", "ref": "11.8.19-21", "rests_on": ["tea:uddhava-gita:11.8.19-21"]}], "antidotes": [], "members": [], "equivalents": [], "coverage": ["A3", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "obs:yosit-sanga", "name": "Sexual association, as the renunciant texts frame it (strī-saṅga)", "category": "bond", "lineages": ["lin:puranic", "lin:advaita-vedanta"], "description": "Texts addressed to male renunciants warn that attachment to women and to men attached to women binds more than any other (the moth, the elephant, Purūravas); the Kapila Gītā applies the parallel warning to a woman's attachment to husband, children and home; the Avadhūta Gītā's eighth chapter states it in harsh terms. Recorded as the texts state it.", "sources": [{"source": "src:uddhava-gita", "ref": "11.8.7-8; 11.8.13-14; 11.26", "rests_on": ["tea:uddhava-gita:11.8.7-8", "tea:uddhava-gita:11.8.13-14", "tea:uddhava-gita:11.26.4-24"]}, {"source": "src:kapila-gita", "ref": "3.31.34-42", "rests_on": ["tea:kapila-gita:3.31.34-42"]}, {"source": "src:avadhuta-gita", "ref": "8.10-26", "rests_on": ["tea:avadhuta-gita:8.10-26"]}], "antidotes": ["solitude", "holy company", "dispassion"], "members": [], "equivalents": [], "coverage": ["A3", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "obs:siddhis-as-obstacles", "name": "Powers as obstacles", "category": "obstacle", "lineages": ["lin:puranic", "lin:advaita-vedanta"], "description": "Yogic powers distract the one seeking the Lord or the Self and waste time.", "sources": [{"source": "src:uddhava-gita", "ref": "11.15.33-34", "rests_on": ["tea:uddhava-gita:11.15.33-34"]}, {"source": "src:moksopaya", "ref": "6.84-86", "rests_on": ["tea:moksopaya:6.84-86"]}], "antidotes": [], "members": [], "equivalents": [], "coverage": ["A3", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "obs:fifteen-evils-of-wealth", "name": "The fifteen evils rooted in wealth", "category": "passion", "lineages": ["lin:puranic"], "description": "Theft, violence, falsehood, hypocrisy, lust, anger, arrogance, pride, divisiveness, enmity, distrust, rivalry and the vices (women, gambling, drink), all rooted in wealth.", "sources": [{"source": "src:uddhava-gita", "ref": "11.23.18-19", "rests_on": ["tea:uddhava-gita:11.23.18-19"]}], "antidotes": [], "members": ["steya", "hiṃsā", "anṛta", "dambha", "kāma", "krodha", "smaya", "mada", "bheda", "vaira", "aviśvāsa", "saṃspardhā", "vyasana (×3)"], "equivalents": [], "coverage": ["A3", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "obs:dussanga", "name": "Bad company (duḥsaṅga)", "category": "bond", "lineages": ["lin:puranic", "lin:advaita-vedanta"], "description": "Association with the sensual and unrighteous, which destroys truth, purity and calm and returns one to darkness.", "sources": [{"source": "src:uddhava-gita", "ref": "11.26.26-34", "rests_on": ["tea:uddhava-gita:11.26.26-34"]}, {"source": "src:kapila-gita", "ref": "3.31.22-33", "rests_on": ["tea:kapila-gita:3.31.22-33"]}, {"source": "src:moksopaya", "ref": "2.11.56-61", "rests_on": ["tea:moksopaya:2.11.56-61"]}], "antidotes": ["prc:satsanga"], "members": [], "equivalents": [], "coverage": ["A3", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "obs:guna-dosa-drsti", "name": "Seeing merit and fault", "category": "obstacle", "lineages": ["lin:puranic"], "description": "Seeing things in terms of merit and fault is itself the fault; being beyond both is the merit.", "sources": [{"source": "src:uddhava-gita", "ref": "11.19.45", "rests_on": ["tea:uddhava-gita:11.19.36-45"]}], "antidotes": [], "members": [], "equivalents": [], "coverage": ["A3", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "obs:trsna", "name": "Craving (tṛṣṇā)", "category": "passion", "lineages": ["lin:advaita-vedanta", "lin:epic-teaching"], "description": "Craving that grows with fulfilment; condemned by Rāma in the Yoga Vāsiṣṭha's first book and sung against in the Maṅki and Kāma Gītās.", "sources": [{"source": "src:moksopaya", "ref": "1.16", "rests_on": ["tea:moksopaya:1.12-28"]}, {"source": "src:manki-gita", "ref": "12.171", "rests_on": ["tea:manki-gita:12.171.4-54"]}, {"source": "src:kama-gita", "ref": "14.13", "rests_on": ["tea:kama-gita:14.13"]}], "antidotes": [], "members": [], "equivalents": [], "coverage": ["A3", "D"], "verification": {"level": "skeleton", "confidence": "moderate", "unverified": false, "checks": []}}
{"id": "obs:ahankara", "name": "Ego (ahaṅkāra)", "category": "affliction", "lineages": ["lin:advaita-vedanta"], "description": "The sense 'I am the doer', first superimposition on the Self; in the story of Dāma, Vyāla and Kaṭa its arising makes the invincible weak.", "sources": [{"source": "src:moksopaya", "ref": "1.14; 4.7-16", "rests_on": ["tea:moksopaya:1.12-28", "tea:moksopaya:4.7-16"]}, {"source": "src:astavakra-gita", "ref": "1.8", "rests_on": ["tea:astavakra-gita:1.7-10"]}, {"source": "src:rama-gita", "ref": "7.5.38", "rests_on": ["tea:rama-gita:7.5.34-41"]}], "antidotes": ["the conviction 'I am not the doer'"], "members": [], "equivalents": [], "coverage": ["A3", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "obs:malina-vasana", "name": "Impure latent tendencies (malina vāsanā)", "category": "impurity", "lineages": ["lin:advaita-vedanta"], "description": "Dark, object-bound tendencies that bind to rebirth; to be replaced by pure tendencies such as friendliness and then abandoned.", "sources": [{"source": "src:moksopaya", "ref": "4.39.18-20; 5.92.28-36", "rests_on": ["tea:moksopaya:4.39.18-20", "tea:moksopaya:5.92.28-36"]}], "antidotes": ["prc:vasana-ksaya-practice"], "members": [], "equivalents": [], "coverage": ["A3", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "obs:daiva-paratva", "name": "Reliance on fate", "category": "obstacle", "lineages": ["lin:advaita-vedanta"], "description": "Relying on fate instead of effort, which the Yoga Vāsiṣṭha calls the delusion of the dull.", "sources": [{"source": "src:moksopaya", "ref": "2.4-8", "rests_on": ["tea:moksopaya:2.4.8-18", "tea:moksopaya:2.6.1-6"]}], "antidotes": ["pauruṣa guided by scripture and the good"], "members": [], "equivalents": [], "coverage": ["A3", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
{"id": "obs:sad-ripu", "name": "The six enemies (ṣaḍ-ripu)", "category": "passion", "lineages": ["lin:sakta"], "description": "Desire, anger, greed, delusion, pride and envy, the six obstacles to yoga pierced by its limbs (Devī Gītā).", "sources": [{"source": "src:devi-gita", "ref": "7.35.3", "rests_on": ["tea:devi-gita:7.35.1-8"]}], "antidotes": ["the eight limbs of yoga"], "members": ["kāma", "krodha", "lobha", "moha", "mada", "mātsarya"], "equivalents": [], "coverage": ["A3", "D"], "verification": {"level": "skeleton", "confidence": "high", "unverified": false, "checks": []}}
