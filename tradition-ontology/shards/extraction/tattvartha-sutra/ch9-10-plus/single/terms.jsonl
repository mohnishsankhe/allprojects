{"id": "trm:pulaka", "term": "pulāka", "language": "Sanskrit", "literal": "", "definitions": [{"lineage": "lin:jainism", "definition": "The first of the five kinds of nirgrantha named in TS 9.46.", "sources": ["src:tattvartha-sutra"], "rests_on": ["tea:tattvartha-sutra:9.46"]}], "verification": {"level": "sourced", "confidence": "high", "protocol": "insight-p1-single+spot"}}
